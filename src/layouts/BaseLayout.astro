---
import "@fontsource/poppins/latin-300.css";
import "@fontsource/poppins/latin-400.css";
import "@fontsource/poppins/latin-500.css";
import "@fontsource/poppins/latin-600.css";
import "@fontsource/poppins/latin-700.css";
import "@fontsource/poppins/latin-800.css";
import "../styles/tokens.css";
import "../styles/global.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { linguaDa, lingue, localeOg, paginaDa, percorsi } from "../i18n";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const titoloCompleto = title === "OCSW" ? title : `${title} — OCSW`;
// Con build.format "file" il percorso finisce in .html: lo togliamo per l'URL pubblico
const percorso = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/") || "/";
const canonical = new URL(percorso, Astro.site ?? Astro.url);
const sito = Astro.site ?? Astro.url;
const lingua = linguaDa(Astro.url);
const pagina = paginaDa(Astro.url);
const t = {
  it: { salta: "Vai al contenuto", ogAlt: "OCSW — Oscar Costanzelli Software. Innovazione digitale per le imprese.", desc: "Siti web, applicazioni web e software su misura per aziende e professionisti, con un unico referente dall'analisi al supporto.", ruolo: "Sviluppatore software" },
  en: { salta: "Skip to content", ogAlt: "OCSW — Oscar Costanzelli Software. Digital innovation for businesses.", desc: "Websites, web applications and custom software for companies and professionals, with one point of contact from analysis to support.", ruolo: "Software developer" },
}[lingua];
---

<!doctype html>
<html lang={lingua}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add("js");
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("anima");
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titoloCompleto}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      pagina &&
        lingue.map((l) => <link rel="alternate" hreflang={l} href={new URL(percorsi[pagina][l], sito)} />)
    }
    {pagina && <link rel="alternate" hreflang="x-default" href={new URL(percorsi[pagina].it, sito)} />}
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0D0D0D" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeOg[lingua]} />
    <meta property="og:site_name" content="OCSW — Oscar Costanzelli Software" />
    <meta property="og:title" content={titoloCompleto} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.png", Astro.site ?? Astro.url)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "@id": "https://ocsw.it/#attivita",
      name: "OCSW — Oscar Costanzelli Software",
      alternateName: "OCSW",
      url: "https://ocsw.it/",
      logo: "https://ocsw.it/icon-512.png",
      image: "https://ocsw.it/og.png",
      description: t.desc,
      email: "oscarcostanzelli@gmail.com",
      telephone: "+39 347 310 8273",
      vatID: "IT02210020380",
      address: {
        "@type": "PostalAddress",
        postalCode: "44012",
        addressLocality: "Bondeno",
        addressRegion: "FE",
        addressCountry: "IT",
      },
      areaServed: ["Provincia di Ferrara", "Emilia-Romagna", "Italia"],
      founder: {
        "@type": "Person",
        name: "Oscar Costanzelli",
        jobTitle: t.ruolo,
      },
    })} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#contenuto">{t.salta}</a>
    <Header />
    <main id="contenuto">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Rivela blocchi e linee quando entrano nello schermo (una volta sola).
      // Anche ciò che sta già sopra lo schermo (salti con ancore, tasto Fine) viene mostrato.
      (function () {
        var restanti = Array.prototype.slice.call(document.querySelectorAll("[data-rivela], [data-linea]"));
        if (!document.documentElement.classList.contains("anima")) {
          restanti.forEach(function (e) { e.classList.add("visibile"); });
          return;
        }
        var inAttesa = false;
        function controlla() {
          inAttesa = false;
          var soglia = window.innerHeight * 0.92;
          restanti = restanti.filter(function (e) {
            if (e.getBoundingClientRect().top < soglia) {
              e.classList.add("visibile");
              return false;
            }
            return true;
          });
          if (!restanti.length) {
            window.removeEventListener("scroll", programma);
            window.removeEventListener("resize", programma);
          }
        }
        function programma() {
          if (!inAttesa) { inAttesa = true; setTimeout(controlla, 60); }
        }
        window.addEventListener("scroll", programma, { passive: true });
        window.addEventListener("resize", programma);
        controlla();
      })();
    </script>
  </body>
</html>
