---
/*
 * Ripamonti: collaborazione limitata al modello 3D dell'Eagle 1025 per il web.
 * Il sito di Ripamonti NON è un lavoro OCSW: dirlo sempre in modo esplicito.
 * Citabile con il permesso del cliente (nome, settore, modello). Niente logo.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Viewer3D from "../components/Viewer3D.astro";
import { link, linguaDa, percorsi } from "../i18n";
import poster from "../assets/progetti/ripamonti/poster-3d.png";

// Sito ufficiale di Ripamonti: da inserire quando confermato (vuoto = nessun link)
const SITO_RIPAMONTI = "";

const lingua = linguaDa(Astro.url);
const t = {
  it: {
    title: "Ripamonti — Modello 3D per il web",
    description: "Il modello 3D della perforatrice Eagle 1025 di Ripamonti, preparato per essere ruotato ed esaminato nel browser: conversione, alleggerimento, materiali e visualizzatore.",
    percorso: "Percorso", progetti: "Progetti",
    tipo: "Collaborazione · Modello 3D",
    intro: "Ripamonti costruisce macchine perforatrici a Ornavasso dal 1934. Ho preparato il modello 3D della perforatrice Eagle 1025 perché si possa ruotare ed esaminare direttamente nel browser.",
    nota: "Il lavoro riguarda il modello 3D: il sito web di Ripamonti non è stato realizzato da me.",
    meta: [
      { voce: "Azienda", valore: "Ripamonti Dr. Gianni Srl, Ornavasso (VB)" },
      { voce: "Settore", valore: "Macchine perforatrici per roccia, fondazioni e cave" },
      { voce: "Modello", valore: "Eagle 1025, perforatrice per micropali e ancoraggi" },
      { voce: "Anno", valore: "2026" },
    ],
    sito: "Sito",
    modello: "Il modello",
    modelloTesto: "Trascinalo per ruotarlo: è lo stesso file pensato per il web, caricato solo quando entra nello schermo.",
    alt: "Modello 3D interattivo della perforatrice Ripamonti Eagle 1025",
    lavoro: "Dal file tecnico al browser",
    passi: [
      { titolo: "Conversione", testo: "Il modello tecnico della macchina convertito in .glb, il formato che i browser sanno mostrare." },
      { titolo: "Alleggerimento", testo: "Meno poligoni e un file più leggero, perché si carichi in fretta anche da telefono senza perdere la forma della macchina." },
      { titolo: "Materiali e colori", testo: "Superfici e colori sistemati perché la macchina si riconosca come nelle foto e nelle brochure." },
      { titolo: "Visualizzatore", testo: "Il modello si ruota con il mouse o con il dito, senza installare nulla, e si carica solo quando serve." },
    ],
    invito: "Hai prodotti tecnici da mostrare in 3D?",
    invitoTesto: "Macchine, utensili, componenti: dal file tecnico al modello che si ruota nel browser.",
    pulsante: "Parliamo del progetto",
  },
  en: {
    title: "Ripamonti — 3D model for the web",
    description: "The 3D model of Ripamonti's Eagle 1025 drilling rig, prepared to be rotated and examined in the browser: conversion, optimisation, materials and viewer.",
    percorso: "Breadcrumb", progetti: "Projects",
    tipo: "Collaboration · 3D model",
    intro: "Ripamonti has been building drilling rigs in Ornavasso, Italy, since 1934. I prepared the 3D model of the Eagle 1025 drilling rig so it can be rotated and examined right in the browser.",
    nota: "This work covers the 3D model: Ripamonti's website was not built by me.",
    meta: [
      { voce: "Company", valore: "Ripamonti Dr. Gianni Srl, Ornavasso (VB), Italy" },
      { voce: "Industry", valore: "Drilling rigs for rock, foundations and quarries" },
      { voce: "Model", valore: "Eagle 1025, micropile and anchor drilling rig" },
      { voce: "Year", valore: "2026" },
    ],
    sito: "Website",
    modello: "The model",
    modelloTesto: "Drag it to rotate: it's the same file prepared for the web, loaded only when it comes into view.",
    alt: "Interactive 3D model of the Ripamonti Eagle 1025 drilling rig",
    lavoro: "From technical file to browser",
    passi: [
      { titolo: "Conversion", testo: "The machine's technical model converted to .glb, the format browsers can display." },
      { titolo: "Optimisation", testo: "Fewer polygons and a lighter file, so it loads quickly even on a phone without losing the shape of the machine." },
      { titolo: "Materials and colours", testo: "Surfaces and colours adjusted so the machine looks as it does in the photos and brochures." },
      { titolo: "Viewer", testo: "The model rotates with a mouse or a finger, with nothing to install, and loads only when needed." },
    ],
    invito: "Have technical products to show in 3D?",
    invitoTesto: "Machines, tools, components: from the technical file to a model that rotates in the browser.",
    pulsante: "Let's talk about your project",
  },
}[lingua];
const passi = t.passi.map((p, i) => ({ ...p, numero: `0${i + 1}` }));
---

<BaseLayout title={t.title} description={t.description}>
  <nav class="breadcrumb" aria-label={t.percorso}>
    <ol>
      <li><a href={percorsi.home[lingua]}>Home</a></li>
      <li><a href={link("home", lingua, "progetti")}>{t.progetti}</a></li>
      <li aria-current="page">Ripamonti</li>
    </ol>
  </nav>

  <!-- Hero -->
  <section class="hero">
    <p class="etichetta tipo">{t.tipo}</p>
    <h1>Ripamonti<span class="punto">.</span></h1>
    <p class="intro">{t.intro}</p>
    <p class="nota">{t.nota}</p>
    <dl class="meta">
      {
        t.meta.map((m, i) => (
          <div class="riga" data-linea="sotto" style={`--colore-linea: var(--linea-scura); --i: ${i}`}>
            <dt class="etichetta">{m.voce}</dt>
            <dd>{m.valore}</dd>
          </div>
        ))
      }
      {
        SITO_RIPAMONTI && (
          <div class="riga" data-linea="sotto" style="--colore-linea: var(--linea-scura); --i: 4">
            <dt class="etichetta">{t.sito}</dt>
            <dd><a href={SITO_RIPAMONTI} rel="noopener">{SITO_RIPAMONTI.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "")} ↗</a></dd>
          </div>
        )
      }
    </dl>
  </section>

  <!-- Il modello -->
  <section class="modello" aria-labelledby="modello-titolo">
    <div class="modello-testa" data-linea="sotto" style="--colore-linea: var(--linea-scura)">
      <h2 id="modello-titolo" data-rivela>{t.modello}<span class="punto">.</span></h2>
      <p data-rivela style="--i: 1">{t.modelloTesto}</p>
    </div>
    <div class="modello-box" data-rivela style="--i: 1">
      <Viewer3D src="/modelli/ripamonti-eagle-1025.glb" alt={t.alt} poster={poster} />
    </div>
  </section>

  <!-- Dal file tecnico al browser -->
  <section class="lavoro su-bianco" aria-labelledby="lavoro-titolo">
    <h2 id="lavoro-titolo" data-rivela>{t.lavoro}<span class="punto">.</span></h2>
    <ol class="passi">
      {
        passi.map((p, i) => (
          <li data-rivela style={`--i: ${i}`}>
            <span class="numero" aria-hidden="true">{p.numero}</span>
            <h3>{p.titolo}</h3>
            <p>{p.testo}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Invito -->
  <section class="invito su-bianco">
    <span class="quadratino" aria-hidden="true"></span>
    <h2 data-rivela>{t.invito}</h2>
    <p data-rivela style="--i: 1">{t.invitoTesto}</p>
    <a class="pulsante pulsante-primario" href={percorsi.contatti[lingua]} data-rivela style="--i: 2">{t.pulsante}</a>
  </section>
</BaseLayout>

<style>
  .punto {
    color: var(--oro);
  }

  /* Breadcrumb */
  .breadcrumb {
    padding: 0 var(--pad-x);
    background: var(--nero);
    border-bottom: var(--bordo-scuro);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    padding: 0;
    list-style: none;
    font-size: var(--testo-small);
    color: var(--grigio-testo-scuro);
  }

  .breadcrumb li {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .breadcrumb li + li::before {
    content: "/";
    margin: 0 0.75rem;
    color: var(--linea-scura);
  }

  .breadcrumb a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    min-width: 44px;
    color: var(--bianco);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
    text-decoration-color: var(--oro);
    text-underline-offset: 4px;
  }

  /* Hero */
  .hero {
    padding: var(--pad-y) var(--pad-x);
    background: var(--nero);
    color: var(--bianco);
  }

  .tipo {
    color: var(--oro);
  }

  h1 {
    margin-top: 1rem;
    font-size: clamp(3.5rem, 1.5rem + 9vw, 10rem);
    font-weight: var(--peso-extrabold);
    line-height: var(--interlinea-display);
    letter-spacing: var(--spaziatura-display);
  }

  .intro {
    max-width: 52ch;
    margin-top: 2rem;
    font-size: var(--testo-lead);
    font-weight: var(--peso-light);
    color: var(--grigio-testo-scuro);
  }

  /* Precisazione onesta: cosa è e cosa non è questo lavoro */
  .nota {
    display: inline-flex;
    align-items: baseline;
    gap: 0.75rem;
    max-width: 60ch;
    margin-top: 1.5rem;
    padding: 0.75rem 1rem;
    border: var(--bordo-scuro);
    font-size: var(--testo-small);
    color: var(--bianco);
  }

  .nota::before {
    content: "";
    flex: none;
    width: 8px;
    height: 8px;
    background: var(--oro);
    transform: translateY(-1px);
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    margin-top: 3rem;
    border-top: var(--bordo-scuro);
  }

  .meta .riga {
    padding: 1.25rem 1.5rem 1.25rem 0;
    border-bottom: var(--bordo-scuro);
  }

  .meta dt {
    color: var(--grigio-testo-scuro);
  }

  .meta dd {
    margin: 0.4rem 0 0;
    font-weight: var(--peso-medium);
  }

  .meta a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: -10px;
    text-decoration-color: var(--linea-scura);
    text-underline-offset: 5px;
  }

  .meta a:hover {
    text-decoration-color: var(--oro);
  }

  /* Il modello, grande, su nero */
  .modello {
    background: var(--nero);
    color: var(--bianco);
    border-top: var(--bordo-scuro);
    border-bottom: var(--bordo);
  }

  .modello-testa {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem var(--gap);
    padding: var(--pad-y) var(--pad-x) calc(var(--pad-y) * 0.6);
    border-bottom: var(--bordo-scuro);
  }

  .modello-testa p {
    max-width: 44ch;
    color: var(--grigio-testo-scuro);
  }

  h2 {
    font-size: var(--testo-h2);
    font-weight: var(--peso-extrabold);
  }

  .modello-box {
    position: relative;
    height: clamp(360px, 70vh, 720px);
  }

  /* Quattro passaggi, griglia 2×2 come il Metodo */
  .lavoro {
    padding: var(--pad-y) var(--pad-x);
    background: var(--bianco);
    border-bottom: var(--bordo);
  }

  .passi {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-top: 2.5rem;
    padding: 0;
    list-style: none;
    border-top: var(--bordo);
    border-left: var(--bordo);
  }

  .passi li {
    padding: 2rem var(--gap) 2.5rem;
    border-right: var(--bordo);
    border-bottom: var(--bordo);
  }

  .numero {
    display: block;
    font-size: clamp(3rem, 2rem + 3vw, 5rem);
    font-weight: var(--peso-extrabold);
    line-height: 0.85;
    letter-spacing: -0.05em;
    color: var(--grigio-numeri-chiaro);
  }

  .passi h3 {
    margin-top: 1.5rem;
    font-size: var(--testo-h3);
    font-weight: var(--peso-bold);
  }

  .passi p {
    max-width: 40ch;
    margin-top: 0.75rem;
    color: var(--grigio-testo-chiaro);
  }

  /* Invito */
  .invito {
    padding: var(--pad-y) var(--pad-x);
    background: var(--bianco);
  }

  .quadratino {
    display: block;
    width: 12px;
    height: 12px;
    margin-bottom: 1.75rem;
    background: var(--oro);
  }

  .invito h2 {
    max-width: 16ch;
  }

  .invito p {
    max-width: 40ch;
    margin-top: 1.25rem;
    font-size: var(--testo-lead);
    font-weight: var(--peso-light);
    color: var(--grigio-testo-chiaro);
  }

  .invito .pulsante {
    margin-top: 2rem;
  }

  @media (max-width: 768px) {
    .passi {
      grid-template-columns: 1fr;
    }

    .invito .pulsante {
      width: 100%;
    }
  }
</style>
