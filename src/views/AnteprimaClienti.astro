---
/*
 * ANTEPRIMA CLIENTI
 * Il cliente inserisce l'ID e la password ricevuti: il modulo li invia direttamente
 * alla bozza del cliente (POST /login), che li verifica e apre le pagine.
 * Questo sito non conosce né salva nessuna password.
 *
 * Per aggiungere un cliente: una riga in PREVIEWS (script in fondo), con l'ID
 * (lo stesso valore di BASIC_AUTH_USER su Cloudflare) e l'indirizzo della sua bozza.
 * Attenzione: l'elenco è leggibile nel codice della pagina.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { linguaDa, percorsi } from "../i18n";

const lingua = linguaDa(Astro.url);
const t = {
  it: {
    title: "Anteprima clienti",
    description: "Accesso riservato ai clienti OCSW per vedere l'anteprima del proprio progetto.",
    parole: ["Anteprima", "clienti"],
    intro: "Inserisci l'ID e la password che ti ho inviato per vedere l'anteprima del tuo progetto.",
    passi: ["Ricevi ID e password", "Li inserisci qui", "Si apre l'anteprima del tuo progetto"],
    passiLabel: "Come funziona",
    nota: "La password viene verificata dall'anteprima del tuo progetto: questo sito non la conserva.",
    invia: "Vedi l'anteprima",
    apertura: "Apertura dell'anteprima…",
    vuoti: "Inserisci ID e password.",
    sconosciuto: "ID non riconosciuto. Controlla quello che ti ho inviato.",
    errate: "ID o password non corretti. Controlla e riprova.",
    nonAttiva: "L'anteprima non è ancora attiva. Scrivimi e ti aiuto.",
    aiuto: "Non hai le credenziali o non funzionano?",
    scrivimi: "Scrivimi",
  },
  en: {
    title: "Client preview",
    description: "Restricted access for OCSW clients to view the preview of their project.",
    parole: ["Client", "preview"],
    intro: "Enter the ID and password I sent you to view the preview of your project.",
    passi: ["You receive an ID and password", "You enter them here", "Your project preview opens"],
    passiLabel: "How it works",
    nota: "Your password is checked by your project preview: this website does not store it.",
    invia: "View the preview",
    apertura: "Opening the preview…",
    vuoti: "Please enter your ID and password.",
    sconosciuto: "ID not recognised. Please check the one I sent you.",
    errate: "Incorrect ID or password. Please check and try again.",
    nonAttiva: "This preview is not active yet. Get in touch and I'll help.",
    aiuto: "Don't have your credentials, or they don't work?",
    scrivimi: "Get in touch",
  },
}[lingua];
---

<BaseLayout title={t.title} description={t.description} noindex>
  <section class="csw-preview" id="anteprima-clienti" aria-labelledby="csw-preview-title">
    <div class="lato">
      <span class="quadratino" aria-hidden="true"></span>
      <h1 id="csw-preview-title">
        {
          t.parole.map((p, i) => (
            <span class="riga">
              <span class="parola" style={`--n: ${i}`}>{p}{i === t.parole.length - 1 && <span class="punto" aria-hidden="true">.</span>}</span>
            </span>
          ))
        }
      </h1>
      <p class="intro">{t.intro}</p>

      <ol class="passi" aria-label={t.passiLabel}>
        {
          t.passi.map((p, i) => (
            <li style={`--n: ${i}`}>
              <span class="n" aria-hidden="true">0{i + 1}</span>
              <span>{p}</span>
            </li>
          ))
        }
      </ol>

      <p class="nota">{t.nota}</p>
    </div>

    <div class="modulo su-bianco">
      <form
        id="csw-preview-form"
        method="post"
        novalidate
        data-msg-vuoti={t.vuoti}
        data-msg-sconosciuto={t.sconosciuto}
        data-apertura={t.apertura}
        data-msg-errate={t.errate}
        data-msg-non-attiva={t.nonAttiva}
      >
        <input type="hidden" name="next" value="/" />
        <div class="campo" style="--n: 0">
          <label for="csw-preview-user">ID</label>
          <input id="csw-preview-user" name="user" autocomplete="username" autocapitalize="none" spellcheck="false" required />
        </div>
        <div class="campo" style="--n: 1">
          <label for="csw-preview-pass">Password</label>
          <input id="csw-preview-pass" name="pass" type="password" autocomplete="current-password" required />
        </div>
        <button class="pulsante pulsante-primario invia" type="submit" style="--n: 2">
          <span class="testo-pulsante">{t.invia}</span>
          <svg class="freccia" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
            <path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
        </button>
        <p class="csw-preview-msg" id="csw-preview-msg" role="alert"></p>
      </form>
      <p class="aiuto">{t.aiuto} <a href={percorsi.contatti[lingua]}>{t.scrivimi}</a></p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
(function () {
  // ID cliente -> indirizzo della sua anteprima su Cloudflare Pages
  var PREVIEWS = {
    'ripamontiocsw': 'https://ripamonti.ocsw.it'
  };

  var form = document.getElementById('csw-preview-form');
  var msg = document.getElementById('csw-preview-msg');
  form.addEventListener('submit', function (e) {
    var id = form.user.value.trim().toLowerCase();
    var base = PREVIEWS[id];
    if (!id || !form.pass.value) { e.preventDefault(); msg.textContent = form.dataset.msgVuoti; return; }
    if (!base) { e.preventDefault(); msg.textContent = form.dataset.msgSconosciuto; return; }
    form.user.value = id;
    form.action = base + '/login'; // invio normale: la bozza imposta l'accesso e mostra le pagine
    msg.textContent = '';
  });
})();
</script>

<script is:inline>
(function () {
  // Solo aspetto: stato "in apertura" quando l'invio è partito, errore che si rianima a ogni tentativo.
  // Non tocca dati né destinazione del modulo (gestiti dallo script qui sopra).
  var form = document.getElementById('csw-preview-form');
  var msg = document.getElementById('csw-preview-msg');
  var testo = form.querySelector('.testo-pulsante');
  var originale = testo.textContent;
  form.addEventListener('submit', function (e) {
    if (e.defaultPrevented) {
      msg.classList.remove('nuovo');
      void msg.offsetWidth;
      msg.classList.add('nuovo');
      return;
    }
    form.classList.add('in-invio');
    testo.textContent = form.dataset.apertura;
  });
  // La bozza rimanda qui dopo un accesso non riuscito: ?errore=1 (ID o password errati),
  // ?errore=0 (credenziali non configurate). Mostro il messaggio e pulisco l'indirizzo.
  var esito = new URLSearchParams(location.search).get('errore');
  if (esito === '1' || esito === '0') {
    msg.textContent = esito === '1' ? form.dataset.msgErrate : form.dataset.msgNonAttiva;
    msg.classList.add('nuovo');
    form.pass.value = '';
    form.user.focus();
    history.replaceState(null, '', location.pathname + location.hash);
  }

  // Tornando indietro dalla bozza il modulo deve essere di nuovo utilizzabile
  window.addEventListener('pageshow', function () {
    form.classList.remove('in-invio');
    testo.textContent = originale;
  });
})();
</script>

<style>
  .csw-preview {
    display: flex;
    flex-wrap: wrap;
    border-bottom: var(--bordo);
  }

  .lato,
  .modulo {
    padding: var(--pad-y) var(--pad-x);
  }

  .lato {
    flex: 1 1 40%;
    display: flex;
    flex-direction: column;
    background: var(--nero);
    color: var(--bianco);
  }

  .modulo {
    flex: 1 1 50%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--bianco);
  }

  .quadratino {
    display: block;
    width: 12px;
    height: 12px;
    margin-bottom: 2rem;
    background: var(--oro);
  }

  h1 {
    font-size: var(--testo-h1);
    font-weight: var(--peso-extrabold);
  }

  .riga {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .parola {
    display: inline-block;
  }

  .punto {
    color: var(--oro);
  }

  .intro {
    max-width: 34ch;
    margin-top: 1.5rem;
    font-size: var(--testo-lead);
    font-weight: var(--peso-light);
    color: var(--grigio-testo-scuro);
  }

  /* Come funziona: tre passi con le linee strutturali */
  .passi {
    max-width: 40ch;
    margin-top: 2.5rem;
    padding: 0;
    list-style: none;
    border-top: var(--bordo-scuro);
  }

  .passi li {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: var(--bordo-scuro);
    font-weight: var(--peso-medium);
  }

  .passi .n {
    flex: none;
    min-width: 1.6rem;
    font-size: var(--testo-small);
    color: var(--oro);
    font-variant-numeric: tabular-nums;
  }

  .nota {
    max-width: 40ch;
    margin-top: auto;
    padding-top: 2.5rem;
    font-size: var(--testo-small);
    color: var(--grigio-testo-scuro);
  }

  /* Modulo */
  form {
    display: grid;
    gap: 0.5rem;
    width: 100%;
    max-width: 440px;
  }

  .campo {
    position: relative;
    display: grid;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  label {
    font-size: var(--testo-small);
    font-weight: var(--peso-semibold);
    transition: color var(--durata) var(--easing);
  }

  input {
    width: 100%;
    min-height: var(--altezza-pulsante);
    padding: 14px 16px;
    background: var(--bianco);
    border: var(--bordo);
    font-size: 1rem;
    caret-color: var(--nero);
  }

  input:focus-visible {
    outline: 2px solid var(--nero);
    outline-offset: 0;
  }

  /* Linea oro che si disegna sotto il campo attivo (decorativa) */
  .campo::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    background: var(--oro);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 500ms var(--uscita);
  }

  .campo:focus-within::after {
    transform: scaleX(1);
  }

  .invia {
    gap: 0.75rem;
    margin-top: 1.75rem;
    overflow: hidden;
    position: relative;
  }

  .freccia {
    transition: transform 300ms var(--uscita);
  }

  .invia:hover .freccia,
  .invia:focus-visible .freccia {
    transform: translateX(4px);
  }

  /* Invio partito: una barra oro scorre nel pulsante finché si apre la bozza */
  .in-invio .invia {
    pointer-events: none;
  }

  .in-invio .invia::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 40%;
    height: 3px;
    background: var(--oro);
    animation: carica 1.1s var(--uscita) infinite;
  }

  .in-invio .freccia {
    display: none;
  }

  .csw-preview-msg {
    min-height: 1.5em;
    font-size: var(--testo-small);
    font-weight: var(--peso-semibold);
    color: var(--nero);
  }

  .csw-preview-msg:not(:empty)::before {
    content: "";
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 0.5rem;
    background: var(--oro);
  }

  .csw-preview-msg.nuovo {
    animation: entra 400ms var(--uscita) both;
  }

  .aiuto {
    max-width: 440px;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: var(--bordo);
    font-size: var(--testo-small);
    color: var(--grigio-testo-chiaro);
  }

  .aiuto a {
    color: var(--nero);
    font-weight: var(--peso-semibold);
    text-underline-offset: 4px;
  }

  /*
   * Momento d'apertura (solo con html.anima, vedi CLAUDE.md › Movimento):
   * il pannello nero scorre, le parole salgono, il punto e il quadratino arrivano,
   * i passi si disegnano, il modulo entra a cascata.
   */
  :global(html.anima) .lato {
    animation: pannello 900ms var(--uscita) both;
  }

  :global(html.anima) .quadratino {
    animation: punto 500ms var(--uscita) both;
    animation-delay: 650ms;
  }

  :global(html.anima) .parola {
    animation: parola 800ms var(--uscita) both;
    animation-delay: calc(250ms + var(--n) * 110ms);
  }

  :global(html.anima) .punto {
    display: inline-block;
    animation: punto 500ms var(--uscita) both;
    animation-delay: 800ms;
  }

  :global(html.anima) .intro {
    animation: entra 700ms var(--uscita) both;
    animation-delay: 550ms;
  }

  :global(html.anima) .passi {
    border-top-color: transparent;
  }

  :global(html.anima) .passi::before {
    content: "";
    display: block;
    height: 1px;
    background: var(--linea-scura);
    transform-origin: left center;
    animation: linea 900ms var(--uscita) both;
    animation-delay: 650ms;
  }

  :global(html.anima) .passi li {
    animation: entra 700ms var(--uscita) both;
    animation-delay: calc(750ms + var(--n) * 120ms);
  }

  :global(html.anima) .nota {
    animation: entra 700ms var(--uscita) both;
    animation-delay: 1150ms;
  }

  :global(html.anima) .campo,
  :global(html.anima) .invia {
    animation: entra 800ms var(--uscita) both;
    animation-delay: calc(450ms + var(--n) * 110ms);
  }

  :global(html.anima) .aiuto {
    animation: entra 800ms var(--uscita) both;
    animation-delay: 800ms;
  }

  @keyframes pannello {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }

  @keyframes parola {
    from { transform: translateY(105%); }
    to { transform: none; }
  }

  @keyframes punto {
    from { transform: scale(0); }
    to { transform: none; }
  }

  @keyframes linea {
    from { transform: scaleX(0); }
    to { transform: none; }
  }

  @keyframes entra {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes carica {
    from { transform: translateX(-100%); }
    to { transform: translateX(250%); }
  }

  /* Riduci movimento: niente barra che scorre, resta il testo "in apertura" */
  @media (prefers-reduced-motion: reduce) {
    .in-invio .invia::after {
      animation: none;
      width: 100%;
    }
  }

  @media (max-width: 900px) {
    .lato,
    .modulo {
      flex-basis: 100%;
    }

    .nota {
      margin-top: 0;
    }
  }

  @media (max-width: 768px) {
    .invia {
      width: 100%;
    }
  }
</style>
