---
import BaseLayout from "../layouts/BaseLayout.astro";
import PrimaDopo from "../components/PrimaDopo.astro";
import Viewer3D from "../components/Viewer3D.astro";
import { link, linguaDa, percorsi } from "../i18n";

import homePrima from "../assets/progetti/carandina/confronti/home-prima.png";
import homeDopo from "../assets/progetti/carandina/confronti/home-dopo.png";
import catalogoPrima from "../assets/progetti/carandina/confronti/catalogo-prima.png";
import catalogoDopo from "../assets/progetti/carandina/confronti/catalogo-dopo.png";
import prodottoPrima from "../assets/progetti/carandina/confronti/prodotto-prima.png";
import prodottoDopo from "../assets/progetti/carandina/confronti/prodotto-dopo.png";

const lingua = linguaDa(Astro.url);
const t = {
  it: {
    title: "Caso studio Carandina",
    description: "Il nuovo sito di Carandina, produttore di utensili di perforazione: homepage, catalogo e schede prodotto a confronto prima e dopo. WordPress con codice su misura e modelli 3D.",
    percorso: "Percorso", progetti: "Progetti",
    tipo: "Caso studio · Cliente",
    intro: "Un'azienda manifatturiera dal 1968, con un sito fermo a molti anni fa. Il nuovo sito presenta i prodotti come li cercano i clienti: per famiglia, con schede tecniche e modelli 3D.",
    meta: [
      { voce: "Settore", valore: "Utensili di perforazione per fondazioni speciali" },
      { voce: "Ambito", valore: "Homepage, catalogo, schede prodotto, 3D" },
      { voce: "Piattaforma", valore: "WordPress con codice su misura" },
      { voce: "Anno", valore: "2026" },
    ],
    sito: "Sito",
    cambiato: "Cosa è cambiato",
    cambiatoTesto: "Tre punti del sito, prima e dopo. Ogni confronto mette le due versioni alla stessa inquadratura: sposta il cursore per vedere la differenza.",
    prima: "Prima", dopo: "Dopo", obiettivo: "Obiettivo",
    capitoli: [
      {
        titolo: "Homepage",
        obiettivo: "Far capire in pochi secondi chi è Carandina e dove andare.",
        altPrima: "La vecchia homepage: barra blu con otto voci di menu, slider fotografico con un riquadro di testo in inglese",
        altDopo: "La nuova homepage: titolo Drilling Equipment & Drilling Tools su video di officina, con due pulsanti",
        prima: [
          "Menu con otto voci, compresa la privacy",
          "Slider di foto con un lungo testo in inglese su riquadro chiaro",
          "Nessuna azione suggerita: i prodotti vanno cercati",
        ],
        dopo: [
          "Menu ridotto alle voci che servono",
          "Un titolo diretto su un video di lavorazione in officina",
          "Due azioni in primo piano: vedere i prodotti o chiedere una consulenza",
        ],
      },
      {
        titolo: "Catalogo",
        obiettivo: "Trovare un prodotto come lo cerca un tecnico: per famiglia e per tipo.",
        altPrima: "Il vecchio catalogo: pagina Shop su fondo grigio con quattro schede prodotto",
        altDopo: "Il nuovo catalogo: pagina Catalogue con menu laterale per famiglie e schede con render 3D",
        prima: [
          "Pagina «Shop» standard del negozio online",
          "Prodotti in un'unica lista, senza famiglie",
          "Schede su fondo grigio, con immagini di dimensioni diverse",
        ],
        dopo: [
          "Pagina «Catalogue» con il percorso di navigazione",
          "Menu laterale per famiglia e sottocategoria",
          "Schede uniformi, ognuna con il render 3D del prodotto",
        ],
      },
      {
        titolo: "Scheda prodotto",
        obiettivo: "Dare a chi valuta un acquisto le informazioni tecniche in ordine.",
        altPrima: "La vecchia scheda prodotto: immagine, pulsante 3D View e un visualizzatore PDF incorporato al posto della descrizione",
        altDopo: "La nuova scheda prodotto: descrizione in testo, pulsanti 3D View e Scheda tecnica PDF, foto dall'officina",
        prima: [
          "Al posto della descrizione, un PDF incorporato nella pagina",
          "Dati tecnici da leggere scorrendo il PDF",
          "Il pulsante 3D View come unico elemento accanto al titolo",
        ],
        dopo: [
          "Una descrizione breve, con la famiglia del prodotto in evidenza",
          "«3D View» e «Scheda tecnica (PDF)» affiancati",
          "Foto reali dall'officina accanto al modello",
        ],
      },
    ],
    i3d: "Il 3D in primo piano",
    i3dTesto: "Gli utensili Carandina sono pezzi tecnici: una foto non basta a capirne la geometria. I modelli 3D (.glb) si ruotano direttamente nel browser, senza installare nulla, e nel nuovo sito accompagnano anche le famiglie di prodotto in homepage.",
    i3dPunti: ["Famiglie di prodotto in homepage con il loro modello 3D", "«3D View» in ogni scheda prodotto", "Funziona da computer e da telefono"],
    i3dAlt: "Modello 3D interattivo di un utensile di perforazione Carandina",
    invito: "Hai un catalogo da portare online?",
    invitoTesto: "Prodotti tecnici, schede da aggiornare, modelli 3D: raccontami da dove parti.",
    pulsante: "Parliamo del progetto",
  },
  en: {
    title: "Carandina case study",
    description: "The new website of Carandina, a drilling tools manufacturer: homepage, catalogue and product pages compared before and after. WordPress with custom code and 3D models.",
    percorso: "Breadcrumb", progetti: "Projects",
    tipo: "Case study · Client",
    intro: "A manufacturing company founded in 1968, with a website that hadn't changed in years. The new site presents the products the way customers look for them: by family, with data sheets and 3D models.",
    meta: [
      { voce: "Industry", valore: "Drilling tools for special foundations" },
      { voce: "Scope", valore: "Homepage, catalogue, product pages, 3D" },
      { voce: "Platform", valore: "WordPress with custom code" },
      { voce: "Year", valore: "2026" },
    ],
    sito: "Website",
    cambiato: "What changed",
    cambiatoTesto: "Three parts of the site, before and after. Each comparison shows both versions with the same framing: move the slider to see the difference.",
    prima: "Before", dopo: "After", obiettivo: "Goal",
    capitoli: [
      {
        titolo: "Homepage",
        obiettivo: "Make it clear in a few seconds who Carandina is and where to go next.",
        altPrima: "The old homepage: blue bar with eight menu items, photo slider with a text box in English",
        altDopo: "The new homepage: the headline Drilling Equipment & Drilling Tools over a workshop video, with two buttons",
        prima: [
          "A menu with eight items, privacy included",
          "A photo slider with a long English text on a light box",
          "No suggested action: products had to be searched for",
        ],
        dopo: [
          "A menu reduced to the items that matter",
          "A direct headline over a video from the workshop",
          "Two actions up front: view the products or ask for technical advice",
        ],
      },
      {
        titolo: "Catalogue",
        obiettivo: "Find a product the way an engineer looks for it: by family and by type.",
        altPrima: "The old catalogue: a Shop page on a grey background with four product cards",
        altDopo: "The new catalogue: a Catalogue page with a side menu by family and cards with 3D renders",
        prima: [
          "A standard online-shop «Shop» page",
          "Products in a single list, with no families",
          "Cards on a grey background, with images of different sizes",
        ],
        dopo: [
          "A «Catalogue» page with breadcrumb navigation",
          "A side menu by family and sub-category",
          "Consistent cards, each with the product's 3D render",
        ],
      },
      {
        titolo: "Product page",
        obiettivo: "Give buyers the technical information in a clear order.",
        altPrima: "The old product page: image, a 3D View button and an embedded PDF viewer instead of a description",
        altDopo: "The new product page: text description, 3D View and PDF data sheet buttons, workshop photos",
        prima: [
          "An embedded PDF instead of a description",
          "Technical data read by scrolling through the PDF",
          "The 3D View button as the only element next to the title",
        ],
        dopo: [
          "A short description, with the product family highlighted",
          "«3D View» and «Data sheet (PDF)» side by side",
          "Real workshop photos next to the model",
        ],
      },
    ],
    i3d: "3D up front",
    i3dTesto: "Carandina's tools are technical parts: a photo isn't enough to understand their geometry. The 3D models (.glb) can be rotated right in the browser, with nothing to install, and on the new site they also accompany the product families on the homepage.",
    i3dPunti: ["Product families on the homepage with their 3D model", "«3D View» on every product page", "Works on desktop and on mobile"],
    i3dAlt: "Interactive 3D model of a Carandina drilling tool",
    invito: "Have a catalogue to bring online?",
    invitoTesto: "Technical products, data sheets to keep updated, 3D models: tell me where you're starting from.",
    pulsante: "Let's talk about your project",
  },
}[lingua];

const immagini = [
  { imgPrima: homePrima, imgDopo: homeDopo },
  { imgPrima: catalogoPrima, imgDopo: catalogoDopo },
  { imgPrima: prodottoPrima, imgDopo: prodottoDopo },
];
const capitoli = t.capitoli.map((c, i) => ({ ...c, ...immagini[i], numero: `0${i + 1}` }));
---

<BaseLayout title={t.title} description={t.description}>
  <nav class="breadcrumb" aria-label={t.percorso}>
    <ol>
      <li><a href={percorsi.home[lingua]}>Home</a></li>
      <li><a href={link("home", lingua, "progetti")}>{t.progetti}</a></li>
      <li aria-current="page">Carandina</li>
    </ol>
  </nav>

  <!-- Hero -->
  <section class="hero">
    <p class="etichetta tipo">{t.tipo}</p>
    <h1>Carandina<span class="punto">.</span></h1>
    <p class="intro">{t.intro}</p>
    <dl class="meta">
      {
        t.meta.map((m, i) => (
          <div class="riga" data-linea="sotto" style={`--colore-linea: var(--linea-scura); --i: ${i}`}>
            <dt class="etichetta">{m.voce}</dt>
            <dd>{m.valore}</dd>
          </div>
        ))
      }
      <div class="riga" data-linea="sotto" style="--colore-linea: var(--linea-scura); --i: 4">
        <dt class="etichetta">{t.sito}</dt>
        <dd><a href="https://carandina.it" rel="noopener">carandina.it ↗</a></dd>
      </div>
    </dl>
  </section>

  <!-- Cosa è cambiato -->
  <section class="cambiato su-bianco" aria-labelledby="cambiato-titolo">
    <div class="cambiato-testa" data-linea="sotto">
      <h2 id="cambiato-titolo" data-rivela>{t.cambiato}<span class="punto">.</span></h2>
      <p data-rivela style="--i: 1">{t.cambiatoTesto}</p>
    </div>

    {
      capitoli.map((c, i) => (
        <article class="capitolo" aria-labelledby={`cap-${i}`}>
          <header class="capo" data-rivela>
            <span class="numero" aria-hidden="true">{c.numero}</span>
            <div>
              <h3 id={`cap-${i}`}>{c.titolo}</h3>
              <p class="obiettivo">
                <span class="etichetta">{t.obiettivo}</span> {c.obiettivo}
              </p>
            </div>
          </header>

          <div data-rivela style="--i: 1">
            <PrimaDopo prima={c.imgPrima} dopo={c.imgDopo} altPrima={c.altPrima} altDopo={c.altDopo} />
          </div>

          <div class="colonne">
            <div class="colonna" data-rivela style="--i: 2">
              <p class="etichetta col-titolo">{t.prima}</p>
              <ol>
                {c.prima.map((p) => <li>{p}</li>)}
              </ol>
            </div>
            <div class="colonna dopo" data-rivela style="--i: 3">
              <p class="etichetta col-titolo">{t.dopo}</p>
              <ol>
                {c.dopo.map((p) => <li>{p}</li>)}
              </ol>
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <!-- Il 3D -->
  <section class="tre-d" aria-labelledby="tre-d-titolo">
    <div class="tre-d-testo" data-rivela>
      <span class="numero" aria-hidden="true">3D</span>
      <h2 id="tre-d-titolo">{t.i3d}<span class="punto">.</span></h2>
      <p>{t.i3dTesto}</p>
      <ul class="punti">
        {t.i3dPunti.map((p) => <li>{p}</li>)}
      </ul>
    </div>
    <div class="tre-d-media">
      <Viewer3D src="/modelli/carandina-bkt100.glb" alt={t.i3dAlt} />
    </div>
  </section>

  <!-- Invito -->
  <section class="invito su-bianco">
    <span class="quadratino" aria-hidden="true"></span>
    <h2 data-rivela>{t.invito}</h2>
    <p data-rivela style="--i: 1">{t.invitoTesto}</p>
    <a class="pulsante pulsante-primario" href={percorsi.contatti[lingua]} data-rivela style="--i: 2">{t.pulsante}</a>
  </section>
</BaseLayout>

<style>
  .punto {
    color: var(--oro);
  }

  /* Breadcrumb */
  .breadcrumb {
    padding: 0 var(--pad-x);
    background: var(--nero);
    border-bottom: var(--bordo-scuro);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    padding: 0;
    list-style: none;
    font-size: var(--testo-small);
    color: var(--grigio-testo-scuro);
  }

  .breadcrumb li {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .breadcrumb li + li::before {
    content: "/";
    margin: 0 0.75rem;
    color: var(--linea-scura);
  }

  .breadcrumb a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    min-width: 44px;
    color: var(--bianco);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
    text-decoration-color: var(--oro);
    text-underline-offset: 4px;
  }

  /* Hero */
  .hero {
    padding: var(--pad-y) var(--pad-x);
    background: var(--nero);
    color: var(--bianco);
  }

  .tipo {
    color: var(--oro);
  }

  h1 {
    margin-top: 1rem;
    font-size: clamp(3.5rem, 1.5rem + 9vw, 10rem);
    font-weight: var(--peso-extrabold);
    line-height: var(--interlinea-display);
    letter-spacing: var(--spaziatura-display);
  }

  .intro {
    max-width: 52ch;
    margin-top: 2rem;
    font-size: var(--testo-lead);
    font-weight: var(--peso-light);
    color: var(--grigio-testo-scuro);
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    margin-top: 3rem;
    border-top: var(--bordo-scuro);
  }

  .meta .riga {
    padding: 1.25rem 1.5rem 1.25rem 0;
    border-bottom: var(--bordo-scuro);
  }

  .meta dt {
    color: var(--grigio-testo-scuro);
  }

  .meta dd {
    margin: 0.4rem 0 0;
    font-weight: var(--peso-medium);
  }

  .meta a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: -10px;
    text-decoration-color: var(--linea-scura);
    text-underline-offset: 5px;
  }

  .meta a:hover {
    text-decoration-color: var(--oro);
  }

  /* Cosa è cambiato */
  .cambiato {
    background: var(--bianco);
    border-bottom: var(--bordo);
  }

  .cambiato-testa {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem var(--gap);
    padding: var(--pad-y) var(--pad-x) calc(var(--pad-y) * 0.6);
    border-bottom: var(--bordo);
  }

  h2 {
    font-size: var(--testo-h2);
    font-weight: var(--peso-extrabold);
  }

  .cambiato-testa p {
    max-width: 44ch;
    color: var(--grigio-testo-chiaro);
  }

  .capitolo {
    max-width: calc(1360px + 2 * var(--pad-x));
    margin-inline: auto;
    padding: var(--pad-y) var(--pad-x);
  }

  .capitolo + .capitolo {
    border-top: var(--bordo);
  }

  .capo {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: end;
    gap: 0 clamp(1.25rem, 0.5rem + 2vw, 2.5rem);
    margin-bottom: 2rem;
  }

  .numero {
    display: block;
    font-size: clamp(3.5rem, 2rem + 4.5vw, 7rem);
    font-weight: var(--peso-extrabold);
    line-height: 0.85;
    letter-spacing: -0.05em;
    color: var(--grigio-numeri-chiaro);
  }

  h3 {
    font-size: var(--testo-h3);
    font-weight: var(--peso-bold);
  }

  .obiettivo {
    max-width: 60ch;
    margin-top: 0.4rem;
    color: var(--grigio-testo-chiaro);
  }

  .obiettivo .etichetta {
    margin-right: 0.5rem;
    color: var(--nero);
  }

  /* Prima | Dopo: due colonne speculari con una linea al centro */
  .colonne {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 2rem;
    border-top: var(--bordo);
  }

  .colonna {
    padding: 1.5rem clamp(1rem, 0.5rem + 2vw, 2.5rem) 0 0;
  }

  .colonna.dopo {
    padding: 1.5rem 0 0 clamp(1rem, 0.5rem + 2vw, 2.5rem);
    border-left: var(--bordo);
  }

  .col-titolo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--grigio-testo-chiaro);
  }

  .col-titolo::before {
    content: "";
    width: 12px;
    height: 12px;
    border: var(--bordo);
  }

  .dopo .col-titolo {
    color: var(--nero);
  }

  .dopo .col-titolo::before {
    background: var(--oro);
    border-color: var(--oro);
  }

  .colonna ol {
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }

  .colonna li {
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--grigio-numeri-chiaro);
    color: var(--grigio-testo-chiaro);
  }

  .colonna.dopo li {
    color: var(--nero);
    font-weight: var(--peso-medium);
  }

  /* Il 3D */
  .tre-d {
    display: flex;
    flex-wrap: wrap;
    background: var(--nero);
    color: var(--bianco);
    border-bottom: var(--bordo);
  }

  .tre-d-testo {
    flex: 1 1 40%;
    padding: var(--pad-y) var(--pad-x);
  }

  .tre-d-testo .numero {
    color: var(--grigio-numeri-scuro);
  }

  .tre-d-testo h2 {
    margin-top: 2rem;
  }

  .tre-d-testo > p {
    max-width: 44ch;
    margin-top: 1.25rem;
    color: var(--grigio-testo-scuro);
  }

  .punti {
    max-width: 44ch;
    margin-top: 2rem;
    padding: 0;
    list-style: none;
    border-top: var(--bordo-scuro);
  }

  .punti li {
    display: flex;
    gap: 0.85rem;
    padding: 0.85rem 0;
    border-bottom: var(--bordo-scuro);
    font-weight: var(--peso-medium);
  }

  .punti li::before {
    content: "";
    flex: none;
    width: 8px;
    height: 8px;
    margin-top: 0.6em;
    background: var(--oro);
  }

  .tre-d-media {
    position: relative;
    flex: 1 1 55%;
    min-width: 0;
    min-height: 520px;
    border-left: var(--bordo-scuro);
  }

  /* Invito */
  .invito {
    padding: var(--pad-y) var(--pad-x);
    background: var(--bianco);
  }

  .quadratino {
    display: block;
    width: 12px;
    height: 12px;
    margin-bottom: 1.75rem;
    background: var(--oro);
  }

  .invito h2 {
    max-width: 16ch;
  }

  .invito p {
    max-width: 40ch;
    margin-top: 1.25rem;
    font-size: var(--testo-lead);
    font-weight: var(--peso-light);
    color: var(--grigio-testo-chiaro);
  }

  .invito .pulsante {
    margin-top: 2rem;
  }

  @media (max-width: 900px) {
    .tre-d-testo,
    .tre-d-media {
      flex-basis: 100%;
    }

    .tre-d-media {
      min-height: 380px;
      border-left: 0;
      border-top: var(--bordo-scuro);
    }
  }

  @media (max-width: 640px) {
    .colonne {
      grid-template-columns: 1fr;
    }

    .colonna,
    .colonna.dopo {
      padding: 1.25rem 0 0;
      border-left: 0;
    }

    .colonna.dopo {
      margin-top: 1rem;
      border-top: var(--bordo);
    }

    .invito .pulsante {
      width: 100%;
    }
  }
</style>
