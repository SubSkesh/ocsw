---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import catalogo from "../assets/progetti/carandina/catalogo.png";
import { link, linguaDa, percorsi } from "../i18n";

interface Props {
  servizio: CollectionEntry<"servizi">;
  precedente?: CollectionEntry<"servizi">;
  successivo?: CollectionEntry<"servizi">;
}

const { servizio, precedente, successivo } = Astro.props;
const s = servizio.data;
const lingua = linguaDa(Astro.url);
const t = {
  it: {
    percorso: "Percorso", servizi: "Servizi", pulsante: "Parliamo del progetto", cosa: "Cosa realizzo",
    lavoro: "Lavoro reale", provaTitolo: "Carandina: restyling e catalogo prodotti",
    provaTesto: "Un sito fermo da anni e nessun catalogo online. Oggi i prodotti sono organizzati per famiglia, con schede tecniche PDF e modelli 3D.",
    provaLink: "Leggi il caso studio", provaAlt: "Il catalogo del nuovo sito Carandina, con menu per famiglie e schede prodotto",
    faq: "Domande frequenti", altri: "Altri servizi", prec: "← Servizio precedente", succ: "Servizio successivo →",
  },
  en: {
    percorso: "Breadcrumb", servizi: "Services", pulsante: "Let's talk about your project", cosa: "What I build",
    lavoro: "Real work", provaTitolo: "Carandina: redesign and product catalogue",
    provaTesto: "A website unchanged for years and no online catalogue. Today the products are organised by family, with PDF data sheets and 3D models.",
    provaLink: "Read the case study", provaAlt: "The catalogue of the new Carandina website, with a menu by family and product cards",
    faq: "Frequently asked questions", altri: "Other services", prec: "← Previous service", succ: "Next service →",
  },
}[lingua];
const href = (e: CollectionEntry<"servizi">) => percorsi[e.data.chiave][lingua];
---

<BaseLayout title={s.titolo} description={s.descrizione}>
  <nav class="breadcrumb" aria-label={t.percorso}>
    <ol>
      <li><a href={percorsi.home[lingua]}>Home</a></li>
      <li><a href={link("home", lingua, "servizi")}>{t.servizi}</a></li>
      <li aria-current="page">{s.titolo}</li>
    </ol>
  </nav>

  <section class="hero">
    <div class="numero-box" aria-hidden="true">
      <span class="numero">{s.numero}</span>
    </div>
    <div class="titolo-box su-bianco">
      <span class="quadratino" aria-hidden="true"></span>
      <h1>{s.titolo}<span class="punto">.</span></h1>
      <p class="intro">{s.intro}</p>
      <a class="pulsante pulsante-primario" href={percorsi.contatti[lingua]}>{t.pulsante}</a>
    </div>
  </section>

  <section class="cosa su-bianco" aria-labelledby="cosa-titolo">
    <h2 id="cosa-titolo" data-rivela>{t.cosa}<span class="punto">.</span></h2>
    <ul class="griglia">
      {
        s.cosa.map((c, i) => (
          <li data-rivela style={`--i: ${i}`}>
            <span class="quadratino piccolo" aria-hidden="true" />
            <h3>{c.titolo}</h3>
            <p>{c.testo}</p>
          </li>
        ))
      }
    </ul>
  </section>

  {
    s.prova && (
      <section class="prova" aria-labelledby="prova-titolo">
        <div class="prova-testo" data-rivela>
          <p class="etichetta prova-tipo">{t.lavoro}</p>
          <h2 id="prova-titolo">{t.provaTitolo}</h2>
          <p>{t.provaTesto}</p>
          <a class="pulsante pulsante-chiaro" href={percorsi.carandina[lingua]}>{t.provaLink}</a>
        </div>
        <div class="prova-img" data-rivela style="--i: 1">
          <Image
            src={catalogo}
            alt={t.provaAlt}
            widths={[600, 900, 1200]}
            sizes="(max-width: 900px) 100vw, 55vw"
          />
        </div>
      </section>
    )
  }

  <section class="faq" aria-labelledby="faq-titolo">
    <h2 id="faq-titolo" data-rivela>{t.faq}<span class="punto">.</span></h2>
    <div class="domande">
      {
        s.faq.map((f) => (
          <details>
            <summary>
              <span>{f.domanda}</span>
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                <path d="M2 8h12M8 2v12" fill="none" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </summary>
            <p>{f.risposta}</p>
          </details>
        ))
      }
    </div>
  </section>

  <nav class="altri" aria-label={t.altri}>
    {
      precedente ? (
        <a class="altro su-bianco" href={href(precedente)}>
          <span class="etichetta">{t.prec}</span>
          <span class="altro-titolo">{precedente.data.numero} {precedente.data.titolo}</span>
        </a>
      ) : (
        <span class="altro vuoto" aria-hidden="true" />
      )
    }
    {
      successivo ? (
        <a class="altro su-bianco destra" href={href(successivo)}>
          <span class="etichetta">{t.succ}</span>
          <span class="altro-titolo">{successivo.data.numero} {successivo.data.titolo}</span>
        </a>
      ) : (
        <span class="altro vuoto" aria-hidden="true" />
      )
    }
  </nav>
</BaseLayout>

<style>
  .punto {
    color: var(--oro);
  }

  .breadcrumb {
    padding: 0 var(--pad-x);
    background: var(--nero);
    border-bottom: var(--bordo-scuro);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    padding: 0;
    list-style: none;
    font-size: var(--testo-small);
    color: var(--grigio-testo-scuro);
  }

  .breadcrumb li {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .breadcrumb li + li::before {
    content: "/";
    margin: 0 0.75rem;
    color: var(--linea-scura);
  }

  .breadcrumb a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--bianco);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
    text-decoration-color: var(--oro);
    text-underline-offset: 4px;
  }

  /* Hero divisa */
  .hero {
    display: flex;
    flex-wrap: wrap;
    border-bottom: var(--bordo);
  }

  .numero-box {
    flex: 1 1 40%;
    display: flex;
    align-items: flex-end;
    padding: var(--pad-y) var(--pad-x);
    background: var(--nero);
  }

  .numero {
    font-size: var(--testo-display);
    font-weight: var(--peso-extrabold);
    line-height: var(--interlinea-display);
    letter-spacing: var(--spaziatura-display);
    color: var(--grigio-numeri-scuro);
  }

  .titolo-box {
    flex: 1 1 55%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--pad-y) var(--pad-x);
    background: var(--bianco);
    border-left: var(--bordo);
  }

  .quadratino {
    display: block;
    width: 12px;
    height: 12px;
    margin-bottom: 2rem;
    background: var(--oro);
  }

  h1 {
    font-size: var(--testo-h1);
    font-weight: var(--peso-extrabold);
  }

  .intro {
    max-width: 38ch;
    margin-top: 1.5rem;
    font-size: var(--testo-lead);
    font-weight: var(--peso-light);
    color: var(--grigio-testo-chiaro);
  }

  .titolo-box .pulsante {
    align-self: flex-start;
    margin-top: 2.5rem;
  }

  h2 {
    font-size: var(--testo-h2);
    font-weight: var(--peso-extrabold);
  }

  /* Cosa realizzo */
  .cosa {
    padding: var(--pad-y) var(--pad-x);
    border-bottom: var(--bordo);
  }

  .griglia {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    margin-top: 2.5rem;
    padding: 0;
    list-style: none;
    border-top: var(--bordo);
    border-left: var(--bordo);
  }

  .griglia li {
    padding: 2rem var(--gap) 2.5rem;
    border-right: var(--bordo);
    border-bottom: var(--bordo);
  }

  .quadratino.piccolo {
    margin-bottom: 1.5rem;
  }

  .griglia h3 {
    font-size: var(--testo-h3);
    font-weight: var(--peso-bold);
  }

  .griglia p {
    margin-top: 0.75rem;
    color: var(--grigio-testo-chiaro);
  }

  /* Lavoro reale */
  .prova {
    display: flex;
    flex-wrap: wrap;
    background: var(--nero);
    color: var(--bianco);
    border-bottom: var(--bordo-scuro);
  }

  .prova-testo {
    flex: 1 1 35%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--pad-y) var(--pad-x);
  }

  .prova-tipo {
    color: var(--oro);
  }

  .prova h2 {
    max-width: 14ch;
    margin-top: 1rem;
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.75rem);
  }

  .prova-testo p:not(.prova-tipo) {
    max-width: 40ch;
    margin-top: 1rem;
    color: var(--grigio-testo-scuro);
  }

  .prova-testo .pulsante {
    align-self: flex-start;
    margin-top: 2rem;
  }

  .prova-img {
    flex: 1 1 55%;
    min-width: 0;
    padding: var(--pad-y) var(--pad-x);
    border-left: var(--bordo-scuro);
  }

  .prova-img :global(img) {
    width: 100%;
    border: var(--bordo-scuro);
  }

  /* FAQ */
  .faq {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem var(--gap);
    padding: var(--pad-y) var(--pad-x);
    background: var(--nero);
    color: var(--bianco);
  }

  .faq h2 {
    flex: 1 1 280px;
    max-width: 10ch;
  }

  .domande {
    flex: 2 1 480px;
    border-top: var(--bordo-scuro);
  }

  details {
    border-bottom: var(--bordo-scuro);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 64px;
    padding: 1rem 0;
    font-size: 1.0625rem;
    font-weight: var(--peso-semibold);
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary svg {
    flex: none;
    color: var(--oro);
    transition: transform var(--durata) var(--easing);
  }

  details[open] summary svg {
    transform: rotate(45deg);
  }

  summary:hover span {
    text-decoration: underline;
    text-decoration-color: var(--oro);
    text-underline-offset: 5px;
  }

  details p {
    max-width: 60ch;
    padding-bottom: 1.5rem;
    color: var(--grigio-testo-scuro);
  }

  /* Precedente / successivo */
  .altri {
    display: flex;
    flex-wrap: wrap;
  }

  .altro {
    flex: 1 1 50%;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 2.5rem var(--pad-x);
    background: var(--bianco);
    color: var(--nero);
    text-decoration: none;
    transition: background-color var(--durata) var(--easing);
  }

  .altro + .altro {
    border-left: var(--bordo);
  }

  .altro .etichetta {
    color: var(--grigio-testo-chiaro);
  }

  .altro-titolo {
    font-size: var(--testo-h3);
    font-weight: var(--peso-bold);
  }

  .altro:hover {
    background: var(--placeholder);
  }

  .vuoto {
    background: var(--bianco);
  }

  .destra {
    align-items: flex-end;
    text-align: right;
  }

  @media (max-width: 900px) {
    .numero-box,
    .titolo-box {
      flex-basis: 100%;
    }

    .titolo-box {
      border-left: 0;
      border-top: var(--bordo);
    }

    .numero-box {
      padding-block: 32px;
    }

    .numero {
      font-size: 6rem;
    }

    .prova-testo,
    .prova-img {
      flex-basis: 100%;
    }

    .prova-img {
      border-left: 0;
      border-top: var(--bordo-scuro);
    }
  }

  @media (max-width: 768px) {
    .titolo-box .pulsante {
      align-self: stretch;
    }

    .altro {
      flex-basis: 100%;
    }

    .altro + .altro {
      border-left: 0;
      border-top: var(--bordo);
    }

    .vuoto {
      display: none;
    }

    .prova-testo .pulsante {
      align-self: stretch;
    }

    .destra {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
