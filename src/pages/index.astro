---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="OCSW"
  description="OCSW — Oscar Costanzelli Software. Siti web, applicazioni web e software su misura per le imprese."
>
  <!-- Contenuto provvisorio: verifica di layout e token. Le sezioni della Home arrivano una alla volta. -->
  <section class="split">
    <div class="nero">
      <p class="display" aria-hidden="true">OC<br />SW<span class="punto">.</span></p>
      <p class="etichetta oro">Oscar Costanzelli Software</p>
    </div>
    <div class="bianco su-bianco">
      <h1>Innovazione digitale per le imprese.</h1>
      <p class="lead">Soluzioni web e software progettate ad hoc.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .split {
    display: flex;
    flex-wrap: wrap;
    border-bottom: var(--bordo);
  }

  .split > div {
    flex: 1 1 50%;
    padding: var(--pad-y) var(--pad-x);
  }

  .nero {
    background: var(--nero);
    color: var(--bianco);
  }

  .display {
    font-size: var(--testo-display);
    font-weight: var(--peso-extrabold);
    line-height: var(--interlinea-display);
    letter-spacing: var(--spaziatura-display);
  }

  .punto,
  .oro {
    color: var(--oro);
  }

  .etichetta {
    margin-top: 2rem;
  }

  .bianco {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
    border-left: var(--bordo);
  }

  h1 {
    font-size: var(--testo-h1);
    font-weight: var(--peso-extrabold);
  }

  .lead {
    font-size: var(--testo-lead);
    font-weight: var(--peso-light);
    color: var(--grigio-testo-chiaro);
  }

  @media (max-width: 768px) {
    .split > div {
      flex-basis: 100%;
    }

    .bianco {
      border-left: 0;
    }
  }
</style>
