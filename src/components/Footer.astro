---
import { link, linguaDa, percorsi } from "../i18n";

const anno = new Date().getFullYear();
const lingua = linguaDa(Astro.url);
const t = {
  it: {
    metodo: "Metodo di lavoro", fasi: ["Analisi", "Progetto", "Sviluppo", "Supporto"],
    slogan: "Un unico referente, dall'analisi al supporto.",
    pie: "Piè di pagina", sito: "Sito", servizi: "Servizi", metodoV: "Metodo", progetti: "Progetti", anteprima: "Anteprima clienti", contatti: "Contatti",
    ruolo: "Sviluppatore software,", laurea: "laureato in Ingegneria Informatica", piva: "P.IVA",
  },
  en: {
    metodo: "How I work", fasi: ["Analysis", "Design", "Development", "Support"],
    slogan: "One point of contact, from analysis to support.",
    pie: "Footer", sito: "Site", servizi: "Services", metodoV: "Method", progetti: "Projects", anteprima: "Client preview", contatti: "Contact",
    ruolo: "Software developer,", laurea: "degree in Computer Engineering", piva: "VAT no.",
  },
}[lingua];
---

<footer class="footer">
  <div class="riga">
    <div class="colonna marchio">
      <p class="logo" aria-hidden="true">OCSW<span class="punto">.</span></p>
      <p class="etichetta nome">Oscar Costanzelli Software</p>
      <ol class="metodo" aria-label={t.metodo}>
        {t.fasi.map((f) => <li>{f}</li>)}
      </ol>
      <p class="slogan">{t.slogan}</p>
    </div>

    <nav class="colonna" aria-label={t.pie}>
      <p class="etichetta titolo">{t.sito}</p>
      <ul>
        <li><a href={link("home", lingua, "servizi")}>{t.servizi}</a></li>
        <li><a href={link("home", lingua, "metodo")}>{t.metodoV}</a></li>
        <li><a href={link("home", lingua, "progetti")}>{t.progetti}</a></li>
        <li><a href={percorsi.anteprima[lingua]}>{t.anteprima}</a></li>
        <li><a href={percorsi.contatti[lingua]}>{t.contatti}</a></li>
      </ul>
    </nav>

    <div class="colonna">
      <p class="etichetta titolo">{t.contatti}</p>
      <address>
        <p>Oscar Costanzelli — {t.ruolo}<br />{t.laurea}</p>
        <p><a href="mailto:oscarcostanzelli@gmail.com">oscarcostanzelli@gmail.com</a></p>
        <p><a href="tel:+393473108273">+39 347 310 8273</a></p>
      </address>
    </div>
  </div>

  <div class="base">
    <p>© {anno} OCSW — Oscar Costanzelli Software</p>
    <p>{t.piva} 02210020380 · <a href={percorsi.privacy[lingua]}>Privacy</a></p>
  </div>
</footer>

<style>
  .footer {
    background: var(--nero);
    color: var(--bianco);
    border-top: var(--bordo);
  }

  .riga {
    display: flex;
    flex-wrap: wrap;
  }

  .colonna {
    flex: 1 1 260px;
    padding: var(--pad-y) var(--pad-x);
    border-right: var(--bordo-scuro);
  }

  .colonna:last-child {
    border-right: 0;
  }

  .marchio {
    flex-grow: 1.4;
  }

  .logo {
    font-size: clamp(3rem, 2rem + 4vw, 5.5rem);
    font-weight: var(--peso-extrabold);
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  .punto {
    color: var(--oro);
  }

  .nome {
    margin-top: 1.25rem;
    color: var(--oro);
  }

  .metodo {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 1.5rem;
    padding: 0;
    list-style: none;
    font-weight: var(--peso-semibold);
  }

  .metodo li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .metodo li::before {
    content: "";
    width: 6px;
    height: 6px;
    background: var(--oro);
  }

  .slogan {
    margin-top: 0.75rem;
    max-width: 32ch;
    color: var(--grigio-testo-scuro);
    font-weight: var(--peso-light);
  }

  .titolo {
    margin-bottom: 1.25rem;
    color: var(--grigio-testo-scuro);
  }

  ul {
    padding: 0;
    list-style: none;
  }

  ul a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: var(--peso-medium);
    text-decoration: none;
    transition: opacity var(--durata) var(--easing);
  }

  ul a:hover {
    opacity: 0.7;
  }

  address {
    font-style: normal;
    color: var(--grigio-testo-scuro);
  }

  address p + p {
    margin-top: 0.15rem;
  }

  address a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--bianco);
    text-underline-offset: 3px;
    text-decoration-color: var(--linea-scura);
    transition: text-decoration-color var(--durata) var(--easing);
  }

  address a:hover {
    text-decoration-color: var(--oro);
  }

  .base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem var(--gap);
    padding: 20px var(--pad-x);
    border-top: var(--bordo-scuro);
    color: var(--grigio-testo-scuro);
    font-size: var(--testo-small);
  }

  .base a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--bianco);
    text-underline-offset: 3px;
  }

  @media (max-width: 768px) {
    .colonna {
      flex-basis: 100%;
      border-right: 0;
      border-bottom: var(--bordo-scuro);
    }

    .colonna:last-child {
      border-bottom: 0;
    }
  }
</style>
