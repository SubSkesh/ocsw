---
---

<section class="hero" aria-labelledby="hero-titolo">
  <div class="marchio">
    <p class="display" aria-hidden="true">OC<br />SW<span class="punto">.</span></p>
    <p class="etichetta nome">Oscar Costanzelli Software</p>
  </div>

  <div class="testo su-bianco">
    <span class="quadratino" aria-hidden="true"></span>
    <h1 id="hero-titolo">Innovazione digitale per le imprese.</h1>
    <p class="lead">
      Soluzioni web e software progettate ad hoc: siti, applicazioni web e
      gestionali, con un unico referente dall'analisi al supporto.
    </p>
    <div class="azioni">
      <a class="pulsante pulsante-primario" href="/contatti">Parliamo del progetto</a>
      <a class="pulsante pulsante-secondario" href="#servizi">Vedi i servizi</a>
    </div>
    <p class="diretto">
      Oppure chiama: <a href="tel:+393473108273">+39 347 310 8273</a>
    </p>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    border-bottom: var(--bordo);
  }

  .hero > div {
    flex: 1 1 50%;
    padding: var(--pad-y) var(--pad-x);
  }

  .marchio {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    min-height: min(78vh, 760px);
    background: var(--nero);
    color: var(--bianco);
  }

  .display {
    font-size: var(--testo-display);
    font-weight: var(--peso-extrabold);
    line-height: var(--interlinea-display);
    letter-spacing: var(--spaziatura-display);
  }

  .punto,
  .nome {
    color: var(--oro);
  }

  .nome {
    padding-top: 1.25rem;
    border-top: var(--bordo-scuro);
  }

  .testo {
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-left: var(--bordo);
  }

  .quadratino {
    width: 12px;
    height: 12px;
    margin-bottom: 2rem;
    background: var(--oro);
  }

  h1 {
    max-width: 12ch;
    font-size: var(--testo-h1);
    font-weight: var(--peso-extrabold);
  }

  .lead {
    max-width: 38ch;
    margin-top: 1.75rem;
    font-size: var(--testo-lead);
    font-weight: var(--peso-light);
    color: var(--grigio-testo-chiaro);
  }

  .azioni {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 2.5rem;
  }

  .diretto {
    margin-top: 1.5rem;
    font-size: var(--testo-small);
    color: var(--grigio-testo-chiaro);
  }

  .diretto a {
    color: var(--nero);
    font-weight: var(--peso-semibold);
    text-underline-offset: 4px;
  }

  @media (max-width: 768px) {
    .hero > div {
      flex-basis: 100%;
    }

    .marchio {
      min-height: auto;
    }

    .testo {
      border-left: 0;
      border-top: var(--bordo);
    }
  }
</style>
