---
---

<section class="hero" aria-labelledby="hero-titolo">
  <div class="marchio">
    <p class="display" aria-hidden="true">
      <span class="riga"><span class="l" style="--n: 0">O</span><span class="l" style="--n: 1">C</span></span><br /><span
        class="riga"><span class="l" style="--n: 2">S</span><span class="l" style="--n: 3">W</span></span><span
        class="punto">.</span>
    </p>
    <p class="etichetta nome">Oscar Costanzelli Software</p>
  </div>

  <div class="testo su-bianco">
    <span class="quadratino" aria-hidden="true"></span>
    <h1 id="hero-titolo">Innovazione digitale per le imprese.</h1>
    <p class="lead">
      Siti web, applicazioni web e software su misura per aziende e
      professionisti. Parli direttamente con chi scrive il codice,
      dall'analisi al supporto.
    </p>
    <div class="azioni">
      <a class="pulsante pulsante-primario" href="/contatti">Parliamo del progetto</a>
      <a class="pulsante pulsante-secondario" href="#servizi">Vedi i servizi</a>
    </div>
    <p class="diretto">
      Oppure scrivi a <a href="mailto:oscarcostanzelli@gmail.com">oscarcostanzelli@gmail.com</a>{" "}
      o chiama il <a href="tel:+393473108273">+39 347 310 8273</a>
    </p>

    <a class="prova" href="/progetti/carandina">
      <span class="etichetta prova-etichetta">Ultimo progetto</span>
      <span class="prova-testo">
        Carandina — restyling, catalogo e visualizzatore 3D
        <svg class="freccia" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </span>
    </a>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    border-bottom: var(--bordo);
  }

  .hero > div {
    flex: 1 1 50%;
    padding: var(--pad-y) var(--pad-x);
  }

  .marchio {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    min-height: min(78vh, 760px);
    background: var(--nero);
    color: var(--bianco);
  }

  .display {
    font-size: var(--testo-display);
    font-weight: var(--peso-extrabold);
    line-height: var(--interlinea-display);
    letter-spacing: var(--spaziatura-display);
  }

  .punto,
  .nome {
    color: var(--oro);
  }

  .nome {
    padding-top: 1.25rem;
    border-top: var(--bordo-scuro);
  }

  .testo {
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-left: var(--bordo);
  }

  .quadratino {
    width: 12px;
    height: 12px;
    margin-bottom: 2rem;
    background: var(--oro);
  }

  h1 {
    max-width: 12ch;
    font-size: var(--testo-h1);
    font-weight: var(--peso-extrabold);
  }

  .lead {
    max-width: 40ch;
    margin-top: 1.75rem;
    font-size: var(--testo-lead);
    font-weight: var(--peso-light);
    color: var(--grigio-testo-chiaro);
  }

  .azioni {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 2.5rem;
  }

  .diretto {
    margin-top: 1.5rem;
    font-size: var(--testo-small);
    color: var(--grigio-testo-chiaro);
  }

  .diretto a {
    color: var(--nero);
    font-weight: var(--peso-semibold);
    text-underline-offset: 4px;
  }

  /* Prova concreta: l'unico progetto cliente pubblicabile */
  .prova {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-width: 40ch;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: var(--bordo);
    text-decoration: none;
  }

  .prova-etichetta {
    color: var(--grigio-testo-chiaro);
  }

  .prova-testo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-weight: var(--peso-semibold);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 5px;
    transition: text-decoration-color var(--durata) var(--easing);
  }

  .prova:hover .prova-testo {
    text-decoration-color: var(--nero);
  }

  .freccia {
    flex: none;
  }

  /*
   * Momento d'apertura (solo con html.anima, vedi CLAUDE.md › Movimento):
   * il pannello nero scorre, le lettere salgono, il punto oro arriva per ultimo,
   * la colonna bianca entra a cascata.
   */
  .riga {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.04em;
  }

  .l {
    display: inline-block;
  }

  .punto {
    display: inline-block;
  }

  :global(html.anima) .marchio {
    animation: pannello 900ms var(--uscita) both;
  }

  :global(html.anima) .l {
    animation: lettera 800ms var(--uscita) both;
    animation-delay: calc(250ms + var(--n) * 90ms);
  }

  :global(html.anima) .punto {
    animation: punto 500ms var(--uscita) both;
    animation-delay: 850ms;
  }

  :global(html.anima) .nome {
    animation: entra 700ms var(--uscita) both;
    animation-delay: 700ms;
  }

  :global(html.anima) .testo > * {
    animation: entra 800ms var(--uscita) both;
  }

  :global(html.anima) .testo > :nth-child(1) { animation-delay: 300ms; }
  :global(html.anima) .testo > :nth-child(2) { animation-delay: 380ms; }
  :global(html.anima) .testo > :nth-child(3) { animation-delay: 460ms; }
  :global(html.anima) .testo > :nth-child(4) { animation-delay: 540ms; }
  :global(html.anima) .testo > :nth-child(5) { animation-delay: 620ms; }
  :global(html.anima) .testo > :nth-child(6) { animation-delay: 700ms; }

  @keyframes pannello {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }

  @keyframes lettera {
    from { transform: translateY(105%); }
    to { transform: none; }
  }

  @keyframes punto {
    from { transform: scale(0); }
    to { transform: none; }
  }

  @keyframes entra {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 768px) {
    .hero > div {
      flex-basis: 100%;
    }

    .marchio {
      min-height: auto;
      gap: 1.5rem;
      padding-block: 32px;
    }

    .display {
      font-size: 3.5rem;
    }

    .display br {
      display: none;
    }

    .nome {
      padding-top: 1rem;
    }

    .testo {
      border-left: 0;
      border-top: var(--bordo);
      padding-top: 32px;
    }

    .quadratino {
      margin-bottom: 1.25rem;
    }

    .lead {
      margin-top: 1.25rem;
    }

    .azioni {
      margin-top: 1.75rem;
    }
  }
</style>
