---
---

<section class="hero" aria-labelledby="hero-titolo">
  <div class="marchio">
    <p class="display" aria-hidden="true">OC<br />SW<span class="punto">.</span></p>
    <p class="etichetta nome">Oscar Costanzelli Software</p>
  </div>

  <div class="testo su-bianco">
    <span class="quadratino" aria-hidden="true"></span>
    <h1 id="hero-titolo">Innovazione digitale per le imprese.</h1>
    <p class="lead">
      Siti web, applicazioni web e software su misura per aziende e
      professionisti. Parli direttamente con chi scrive il codice,
      dall'analisi al supporto.
    </p>
    <div class="azioni">
      <a class="pulsante pulsante-primario" href="/contatti">Parliamo del progetto</a>
      <a class="pulsante pulsante-secondario" href="#servizi">Vedi i servizi</a>
    </div>
    <p class="diretto">
      Oppure chiama: <a href="tel:+393473108273">+39 347 310 8273</a>
    </p>

    <a class="prova" href="https://www.carandina.it" rel="noopener">
      <span class="etichetta prova-etichetta">Ultimo progetto</span>
      <span class="prova-testo">
        Carandina — restyling, catalogo e visualizzatore 3D
        <svg class="freccia" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <path d="M3 13L13 3M6 3h7v7" fill="none" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </span>
    </a>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    border-bottom: var(--bordo);
  }

  .hero > div {
    flex: 1 1 50%;
    padding: var(--pad-y) var(--pad-x);
  }

  .marchio {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    min-height: min(78vh, 760px);
    background: var(--nero);
    color: var(--bianco);
  }

  .display {
    font-size: var(--testo-display);
    font-weight: var(--peso-extrabold);
    line-height: var(--interlinea-display);
    letter-spacing: var(--spaziatura-display);
  }

  .punto,
  .nome {
    color: var(--oro);
  }

  .nome {
    padding-top: 1.25rem;
    border-top: var(--bordo-scuro);
  }

  .testo {
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-left: var(--bordo);
  }

  .quadratino {
    width: 12px;
    height: 12px;
    margin-bottom: 2rem;
    background: var(--oro);
  }

  h1 {
    max-width: 12ch;
    font-size: var(--testo-h1);
    font-weight: var(--peso-extrabold);
  }

  .lead {
    max-width: 40ch;
    margin-top: 1.75rem;
    font-size: var(--testo-lead);
    font-weight: var(--peso-light);
    color: var(--grigio-testo-chiaro);
  }

  .azioni {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 2.5rem;
  }

  .diretto {
    margin-top: 1.5rem;
    font-size: var(--testo-small);
    color: var(--grigio-testo-chiaro);
  }

  .diretto a {
    color: var(--nero);
    font-weight: var(--peso-semibold);
    text-underline-offset: 4px;
  }

  /* Prova concreta: l'unico progetto cliente pubblicabile */
  .prova {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-width: 40ch;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: var(--bordo);
    text-decoration: none;
  }

  .prova-etichetta {
    color: var(--grigio-testo-chiaro);
  }

  .prova-testo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-weight: var(--peso-semibold);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 5px;
    transition: text-decoration-color var(--durata) var(--easing);
  }

  .prova:hover .prova-testo {
    text-decoration-color: var(--nero);
  }

  .freccia {
    flex: none;
  }

  @media (max-width: 768px) {
    .hero > div {
      flex-basis: 100%;
    }

    .marchio {
      min-height: auto;
      gap: 1.5rem;
      padding-block: 32px;
    }

    .display {
      font-size: 4rem;
    }

    .nome {
      padding-top: 1rem;
    }

    .testo {
      border-left: 0;
      border-top: var(--bordo);
      padding-top: 32px;
    }

    .quadratino {
      margin-bottom: 1.25rem;
    }

    .lead {
      margin-top: 1.25rem;
    }

    .azioni {
      margin-top: 1.75rem;
    }
  }
</style>
