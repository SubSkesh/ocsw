---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { linguaDa } from "../i18n";

/*
 * Confronto prima/dopo. Le due immagini devono avere lo stesso formato
 * (qui 1760×800, 2,2:1) e la stessa inquadratura: così la linea divide
 * davvero la stessa pagina in due epoche.
 * Desktop: cursore trascinabile sull'immagine + range accessibile.
 * Telefono: le due versioni una sopra l'altra, stessa dimensione.
 */
interface Props {
  prima: ImageMetadata;
  dopo: ImageMetadata;
  altPrima: string;
  altDopo: string;
  /** Tono della sezione che lo contiene: cambia solo i colori del controllo */
  tono?: "chiaro" | "scuro";
}

const { prima, dopo, altPrima, altDopo, tono = "chiaro" } = Astro.props;
const t = {
  it: { prima: "Prima", dopo: "Dopo", label: "Trascina sull'immagine o sposta il cursore", nuova: "versione nuova" },
  en: { prima: "Before", dopo: "After", label: "Drag on the image or move the slider", nuova: "new version" },
}[linguaDa(Astro.url)];
const id = `confronto-${Math.random().toString(36).slice(2, 8)}`;
const misure = { widths: [880, 1320, 1760], sizes: "(max-width: 768px) 100vw, min(100vw, 1360px)" };
---

<figure class:list={["confronto", tono]} style="--pos: 50%" data-nuova={t.nuova}>
  <div class="cornice">
    <div class="livello">
      <Image class="img" src={prima} alt={altPrima} {...misure} />
    </div>
    <div class="livello dopo">
      <Image class="img" src={dopo} alt={altDopo} {...misure} />
    </div>
    <span class="linea" aria-hidden="true"><span class="maniglia"></span></span>
    <span class="etichetta tag tag-prima" aria-hidden="true">{t.prima}</span>
    <span class="etichetta tag tag-dopo" aria-hidden="true">{t.dopo}</span>
  </div>

  <div class="controllo">
    <label class="etichetta" for={id}>{t.label}</label>
    <input id={id} type="range" min="0" max="100" value="50" aria-valuetext={`50% ${t.nuova}`} />
  </div>

  {/* Telefono: coppia impilata */}
  <div class="coppia" aria-hidden="true">
    <div class="pannello">
      <span class="etichetta tag">{t.prima}</span>
      <Image class="img" src={prima} alt="" widths={[440, 880]} sizes="100vw" />
    </div>
    <div class="pannello">
      <span class="etichetta tag tag-oro">{t.dopo}</span>
      <Image class="img" src={dopo} alt="" widths={[440, 880]} sizes="100vw" />
    </div>
  </div>
</figure>

<script>
  document.querySelectorAll<HTMLElement>(".confronto").forEach((box) => {
    const range = box.querySelector<HTMLInputElement>("input[type=range]")!;
    const cornice = box.querySelector<HTMLElement>(".cornice")!;

    const imposta = (v: number) => {
      range.value = String(Math.round(Math.min(100, Math.max(0, v))));
      box.style.setProperty("--pos", `${range.value}%`);
      range.setAttribute("aria-valuetext", `${100 - Number(range.value)}% ${box.dataset.nuova}`);
    };

    range.addEventListener("input", () => imposta(Number(range.value)));

    // Trascinamento diretto sull'immagine; il range resta il controllo accessibile
    const daPuntatore = (e: PointerEvent) => {
      const r = cornice.getBoundingClientRect();
      imposta(((e.clientX - r.left) / r.width) * 100);
    };
    cornice.addEventListener("pointerdown", (e) => {
      cornice.setPointerCapture(e.pointerId);
      box.classList.add("trascina");
      daPuntatore(e);
    });
    cornice.addEventListener("pointermove", (e) => {
      if (cornice.hasPointerCapture(e.pointerId)) daPuntatore(e);
    });
    const fine = () => box.classList.remove("trascina");
    cornice.addEventListener("pointerup", fine);
    cornice.addEventListener("pointercancel", fine);

    imposta(Number(range.value));
  });
</script>

<style>
  .confronto {
    --bordo-cornice: var(--bordo);
    --testo-controllo: var(--grigio-testo-chiaro);
    --traccia: var(--grigio-numeri-chiaro);
    margin: 0;
  }

  .confronto.scuro {
    --bordo-cornice: var(--bordo-scuro);
    --testo-controllo: var(--grigio-testo-scuro);
    --traccia: var(--linea-scura);
  }

  .cornice {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1760 / 800;
    border: var(--bordo-cornice);
    background: var(--placeholder);
    cursor: ew-resize;
    touch-action: pan-y;
    user-select: none;
  }

  .livello {
    position: absolute;
    inset: 0;
  }

  .cornice :global(.img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  /* La versione nuova copre la vecchia a destra del cursore */
  .dopo {
    clip-path: inset(0 0 0 var(--pos));
  }

  .linea {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: var(--oro);
    pointer-events: none;
  }

  /* Maniglia quadrata al centro della linea: dice "trascinami" */
  .maniglia {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 36px;
    height: 36px;
    background: var(--nero);
    border: 2px solid var(--oro);
    transform: translate(-50%, -50%);
    transition: transform var(--durata) var(--easing);
  }

  .maniglia::before,
  .maniglia::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 0;
    height: 0;
    border-block: 5px solid transparent;
    transform: translateY(-50%);
  }

  .maniglia::before {
    left: 7px;
    border-right: 6px solid var(--oro);
  }

  .maniglia::after {
    right: 7px;
    border-left: 6px solid var(--oro);
  }

  .trascina .maniglia {
    transform: translate(-50%, -50%) scale(1.12);
  }

  .tag {
    position: absolute;
    top: 16px;
    padding: 6px 10px;
    background: var(--nero);
    color: var(--bianco);
    pointer-events: none;
  }

  .tag-prima {
    left: 16px;
  }

  .tag-dopo {
    right: 16px;
    color: var(--oro);
  }

  .controllo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: 1rem;
  }

  .controllo label {
    color: var(--testo-controllo);
  }

  input[type="range"] {
    flex: 1 1 240px;
    height: 44px;
    margin: 0;
    background: transparent;
    appearance: none;
    cursor: ew-resize;
  }

  input[type="range"]::-webkit-slider-runnable-track {
    height: 2px;
    background: var(--traccia);
  }

  input[type="range"]::-moz-range-track {
    height: 2px;
    background: var(--traccia);
  }

  input[type="range"]::-webkit-slider-thumb {
    width: 20px;
    height: 20px;
    margin-top: -9px;
    background: var(--oro);
    border: 0;
    border-radius: 0;
    appearance: none;
  }

  input[type="range"]::-moz-range-thumb {
    width: 20px;
    height: 20px;
    background: var(--oro);
    border: 0;
    border-radius: 0;
  }

  input[type="range"]:focus-visible {
    outline: 2px solid var(--oro);
    outline-offset: 2px;
  }

  .coppia {
    display: none;
  }

  /* Telefono: due pannelli uguali, uno sopra l'altro */
  @media (max-width: 768px) {
    .cornice,
    .controllo {
      display: none;
    }

    .coppia {
      display: grid;
      gap: 12px;
    }

    .pannello {
      position: relative;
      aspect-ratio: 1760 / 800;
      overflow: hidden;
      border: var(--bordo-cornice);
      background: var(--placeholder);
    }

    .pannello :global(.img) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .pannello .tag {
      top: 10px;
      left: 10px;
      padding: 4px 8px;
      z-index: 1;
    }

    .tag-oro {
      color: var(--oro);
    }
  }
</style>
