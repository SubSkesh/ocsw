---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { linguaDa } from "../i18n";

interface Props {
  prima: ImageMetadata;
  dopo: ImageMetadata;
  primaMobile: ImageMetadata;
  dopoMobile: ImageMetadata;
  altPrima: string;
  altDopo: string;
}

const { prima, dopo, primaMobile, dopoMobile, altPrima, altDopo } = Astro.props;
const t = {
  it: { prima: "Prima", dopo: "Dopo", label: "Trascina sull'immagine o sposta il cursore", nuova: "versione nuova" },
  en: { prima: "Before", dopo: "After", label: "Drag on the image or move the slider", nuova: "new version" },
}[linguaDa(Astro.url)];
const id = `confronto-${Math.random().toString(36).slice(2, 8)}`;
---

<figure class="confronto" style="--pos: 50%" data-nuova={t.nuova}>
  <div class="cornice">
    <!-- Desktop: homepage a 1440px; telefono: homepage a 390px -->
    <div class="livello prima">
      <Image class="img desk" src={prima} alt={altPrima} widths={[960, 1440]} sizes="100vw" />
      <Image class="img mob" src={primaMobile} alt={altPrima} widths={[390, 780]} sizes="100vw" />
    </div>
    <div class="livello dopo">
      <Image class="img desk" src={dopo} alt={altDopo} widths={[960, 1440]} sizes="100vw" />
      <Image class="img mob" src={dopoMobile} alt={altDopo} widths={[390, 780]} sizes="100vw" />
    </div>
    <span class="linea" aria-hidden="true"></span>
    <span class="etichetta tag tag-prima" aria-hidden="true">{t.prima}</span>
    <span class="etichetta tag tag-dopo" aria-hidden="true">{t.dopo}</span>
  </div>

  <div class="controllo">
    <label class="etichetta" for={id}>{t.label}</label>
    <input id={id} type="range" min="0" max="100" value="50" aria-valuetext={`50% ${t.nuova}`} />
  </div>
</figure>

<script>
  document.querySelectorAll<HTMLElement>(".confronto").forEach((box) => {
    const range = box.querySelector<HTMLInputElement>("input[type=range]")!;
    const cornice = box.querySelector<HTMLElement>(".cornice")!;

    const imposta = (v: number) => {
      range.value = String(Math.round(Math.min(100, Math.max(0, v))));
      box.style.setProperty("--pos", `${range.value}%`);
      range.setAttribute("aria-valuetext", `${100 - Number(range.value)}% ${box.dataset.nuova}`);
    };

    range.addEventListener("input", () => imposta(Number(range.value)));

    // Trascinamento diretto sull'immagine; il range resta il controllo accessibile
    const daPuntatore = (e: PointerEvent) => {
      const r = cornice.getBoundingClientRect();
      imposta(((e.clientX - r.left) / r.width) * 100);
    };
    cornice.addEventListener("pointerdown", (e) => {
      cornice.setPointerCapture(e.pointerId);
      daPuntatore(e);
    });
    cornice.addEventListener("pointermove", (e) => {
      if (cornice.hasPointerCapture(e.pointerId)) daPuntatore(e);
    });

    imposta(Number(range.value));
  });
</script>

<style>
  .confronto {
    margin: 0;
  }

  .cornice {
    position: relative;
    overflow: hidden;
    max-width: calc(70vh * 1440 / 900);
    margin-inline: auto;
    aspect-ratio: 1440 / 900;
    border: var(--bordo-scuro);
    background: var(--nero);
    cursor: ew-resize;
    touch-action: pan-y;
    user-select: none;
  }

  .livello {
    position: absolute;
    inset: 0;
  }

  .cornice :global(.img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    pointer-events: none;
  }

  .cornice :global(.mob) {
    display: none;
  }

  /* La versione nuova copre la vecchia a destra del cursore */
  .dopo {
    clip-path: inset(0 0 0 var(--pos));
  }

  .linea {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: var(--oro);
    pointer-events: none;
  }

  .tag {
    position: absolute;
    top: 16px;
    padding: 6px 10px;
    background: var(--nero);
    color: var(--bianco);
    pointer-events: none;
  }

  .tag-prima {
    left: 16px;
  }

  .tag-dopo {
    right: 16px;
    color: var(--oro);
  }

  .controllo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    max-width: calc(70vh * 1440 / 900);
    margin: 1rem auto 0;
  }

  .controllo label {
    color: var(--grigio-testo-scuro);
  }

  input[type="range"] {
    flex: 1 1 240px;
    height: 44px;
    margin: 0;
    background: transparent;
    appearance: none;
    cursor: ew-resize;
  }

  input[type="range"]::-webkit-slider-runnable-track {
    height: 2px;
    background: var(--linea-scura);
  }

  input[type="range"]::-moz-range-track {
    height: 2px;
    background: var(--linea-scura);
  }

  input[type="range"]::-webkit-slider-thumb {
    width: 20px;
    height: 20px;
    margin-top: -9px;
    background: var(--oro);
    border: 0;
    border-radius: 0;
    appearance: none;
  }

  input[type="range"]::-moz-range-thumb {
    width: 20px;
    height: 20px;
    background: var(--oro);
    border: 0;
    border-radius: 0;
  }

  input[type="range"]:focus-visible {
    outline: 2px solid var(--oro);
    outline-offset: 2px;
  }

  /* Telefono: confronto tra le due homepage viste da telefono */
  @media (max-width: 768px) {
    .cornice {
      max-width: 100%;
      aspect-ratio: 390 / 844;
      max-height: 75vh;
    }

    .cornice :global(.desk) {
      display: none;
    }

    .cornice :global(.mob) {
      display: block;
    }

    .controllo {
      max-width: 100%;
    }
  }
</style>
