---
import { link, linguaDa, paginaDa, percorsoPulito, percorsi, type Lingua } from "../i18n";

const lingua = linguaDa(Astro.url);
const altra: Lingua = lingua === "it" ? "en" : "it";
const pagina = paginaDa(Astro.url);
// Stessa pagina nell'altra lingua (la home se la pagina non ha equivalente, es. 404)
const linkAltra = percorsi[pagina ?? "home"][altra];

const t = {
  it: { servizi: "Servizi", metodo: "Metodo", progetti: "Progetti", anteprima: "Anteprima clienti", contatti: "Contatti", principale: "Principale", menu: "Menu", chiudi: "Chiudi", cambia: "English version" },
  en: { servizi: "Services", metodo: "Method", progetti: "Projects", anteprima: "Client preview", contatti: "Contact", principale: "Main", menu: "Menu", chiudi: "Close", cambia: "Versione italiana" },
}[lingua];

const voci = [
  { href: link("home", lingua, "servizi"), label: t.servizi, sezione: "servizi" },
  { href: link("home", lingua, "metodo"), label: t.metodo, sezione: "metodo" },
  { href: link("home", lingua, "progetti"), label: t.progetti, sezione: "progetti" },
  // Laboratorio: da aggiungere quando c'è una demo funzionante (vedi CLAUDE.md)
  { href: percorsi.anteprima[lingua], label: t.anteprima, sezione: "anteprima" },
];

const path = percorsoPulito(Astro.url.pathname);
const attiva = (sezione: string) =>
  (sezione === "servizi" && path.includes("/servizi/")) ||
  (sezione === "servizi" && path.includes("/services/")) ||
  (sezione === "progetti" && (path.includes("/progetti/") || path.includes("/projects/"))) ||
  (sezione === "anteprima" && pagina === "anteprima");
const contattiAttivo = pagina === "contatti";
---

<header class="header">
  <a class="logo" href={percorsi.home[lingua]} aria-label="OCSW — Home">OCSW<span class="punto">.</span></a>

  <button
    class="toggle"
    type="button"
    aria-expanded="false"
    aria-controls="nav-principale"
    data-menu={t.menu}
    data-chiudi={t.chiudi}
  >
    <span class="toggle-testo">{t.menu}</span>
  </button>

  <nav id="nav-principale" class="nav" aria-label={t.principale}>
    <ul>
      {
        voci.map((v) => (
          <li>
            <a
              href={v.href}
              class:list={["voce", { attiva: attiva(v.sezione) }]}
              aria-current={attiva(v.sezione) ? "page" : undefined}
            >
              {v.label}
            </a>
          </li>
        ))
      }
      <li>
        <a class="voce lingua" href={linkAltra} hreflang={altra} lang={altra} aria-label={t.cambia}>
          <span class:list={{ corrente: lingua === "it" }}>IT</span><span class="barra" aria-hidden="true">/</span><span class:list={{ corrente: lingua === "en" }}>EN</span>
        </a>
      </li>
      <li>
        <a
          href={percorsi.contatti[lingua]}
          class:list={["contatti", { attiva: contattiAttivo }]}
          aria-current={contattiAttivo ? "page" : undefined}
        >
          {t.contatti}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".header .toggle");
  const nav = document.getElementById("nav-principale");

  if (toggle && nav) {
    const imposta = (aperto: boolean) => {
      toggle.setAttribute("aria-expanded", String(aperto));
      toggle.querySelector(".toggle-testo")!.textContent = (aperto ? toggle.dataset.chiudi : toggle.dataset.menu) ?? "";
      nav.classList.toggle("aperta", aperto);
    };

    toggle.addEventListener("click", () => {
      imposta(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) imposta(false);
    });

    document.addEventListener("click", (e) => {
      if (
        toggle.getAttribute("aria-expanded") === "true" &&
        !(e.target as HTMLElement).closest(".header")
      ) {
        imposta(false);
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        imposta(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap);
    min-height: 88px;
    padding: 0 var(--pad-x);
    background: var(--nero);
    color: var(--bianco);
    border-bottom: var(--bordo-scuro);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 1.75rem;
    font-weight: var(--peso-extrabold);
    letter-spacing: -0.04em;
    line-height: 1;
    text-decoration: none;
  }

  .punto {
    color: var(--oro);
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 0.5rem + 1.5vw, 2.5rem);
    padding: 0;
    list-style: none;
  }

  .voce,
  .contatti {
    display: inline-flex;
    align-items: center;
    min-height: var(--altezza-pulsante-nav);
    font-size: var(--testo-small);
    font-weight: var(--peso-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity var(--durata) var(--easing), color var(--durata) var(--easing);
  }

  .voce {
    position: relative;
    color: var(--grigio-testo-scuro);
  }

  .voce:hover,
  .voce.attiva {
    color: var(--bianco);
  }

  .voce.attiva::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 6px;
    height: 2px;
    background: var(--oro);
  }

  .lingua {
    gap: 0.35rem;
  }

  .lingua .barra {
    color: var(--linea-scura);
  }

  .lingua .corrente {
    color: var(--bianco);
  }

  .lingua:hover span:not(.corrente):not(.barra) {
    color: var(--oro);
  }

  .contatti {
    padding: 0 22px;
    border: 1px solid var(--bianco);
    color: var(--bianco);
    transition: background-color var(--durata) var(--easing), color var(--durata) var(--easing);
  }

  .contatti:hover {
    background: var(--bianco);
    color: var(--nero);
  }

  /* Unica campitura oro ammessa: Contatti attivo nella pagina Contatti */
  .contatti.attiva {
    background: var(--oro);
    border-color: var(--oro);
    color: var(--nero);
  }

  .toggle {
    display: none;
  }

  @media (max-width: 960px) {
    .header {
      min-height: 72px;
    }

    .logo {
      font-size: 1.5rem;
    }

    /* Senza JavaScript il menu resta visibile e il pulsante sparisce */
    :global(html:not(.js)) .header {
      flex-wrap: wrap;
      padding-block: 14px;
    }

    :global(html:not(.js)) .toggle {
      display: none;
    }

    :global(html:not(.js)) .nav {
      display: block;
      position: static;
      flex-basis: 100%;
      margin-inline: calc(var(--pad-x) * -1);
      border-bottom: 0;
    }

    .toggle {
      display: inline-flex;
      align-items: center;
      min-height: var(--altezza-pulsante-nav);
      padding: 0 18px;
      background: transparent;
      border: 1px solid var(--bianco);
      font-size: var(--testo-small);
      font-weight: var(--peso-semibold);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      cursor: pointer;
    }

    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 50;
      background: var(--nero);
      border-top: var(--bordo-scuro);
      border-bottom: var(--bordo-scuro);
    }

    .nav.aperta {
      display: block;
    }

    .nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav li + li {
      border-top: var(--bordo-scuro);
    }

    .voce,
    .contatti {
      width: 100%;
      min-height: 56px;
      padding: 0 var(--pad-x);
      font-size: 1rem;
    }

    .voce.attiva::after {
      left: var(--pad-x);
      right: auto;
      width: 24px;
      bottom: 12px;
    }

    .contatti {
      border: 0;
      background: var(--bianco);
      color: var(--nero);
    }

    .contatti.attiva {
      background: var(--oro);
    }
  }
</style>
