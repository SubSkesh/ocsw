---
import Viewer3D from "./Viewer3D.astro";
import { linguaDa, percorsi } from "../i18n";
import posterRipamonti from "../assets/progetti/ripamonti/poster-3d.png";

const lingua = linguaDa(Astro.url);
const t = {
  it: {
    titolo: "Progetti",
    intro: "Ogni progetto raccontato per quello che è: il problema, le scelte, il risultato.",
    progetti: [
      {
        chiave: "carandina" as const,
        nome: "Carandina",
        tipo: "Caso studio · Sito web",
        punti: ["Restyling del sito", "Visualizzatore 3D dei prodotti", "Catalogo e schede tecniche PDF"],
        link: "Leggi il caso studio",
        modello: "/modelli/carandina-bkt100.glb",
        alt: "Modello 3D interattivo di un utensile di perforazione Carandina, come mostrato sul sito del cliente",
      },
      {
        chiave: "ripamonti" as const,
        nome: "Ripamonti",
        tipo: "Collaborazione · Modello 3D",
        punti: ["Modello 3D della perforatrice Eagle 1025", "Conversione e alleggerimento per il web", "Visualizzatore nel browser"],
        link: "Vedi il lavoro",
        modello: "/modelli/ripamonti-eagle-1025.glb",
        alt: "Modello 3D interattivo della perforatrice Ripamonti Eagle 1025",
      },
    ],
    invito: "Il prossimo potrebbe essere il tuo.",
    invitoTesto: "Raccontami cosa deve fare il tuo sito o il tuo software. Dal primo contatto capiamo se e come posso aiutarti; l'analisi vera e propria è la prima fase del lavoro.",
    pulsante: "Parliamo del progetto",
  },
  en: {
    titolo: "Projects",
    intro: "Each project told as it is: the problem, the choices, the result.",
    progetti: [
      {
        chiave: "carandina" as const,
        nome: "Carandina",
        tipo: "Case study · Website",
        punti: ["Website redesign", "3D product viewer", "Catalogue and PDF data sheets"],
        link: "Read the case study",
        modello: "/modelli/carandina-bkt100.glb",
        alt: "Interactive 3D model of a Carandina drilling tool, as shown on the client's website",
      },
      {
        chiave: "ripamonti" as const,
        nome: "Ripamonti",
        tipo: "Collaboration · 3D model",
        punti: ["3D model of the Eagle 1025 drilling rig", "Conversion and optimisation for the web", "In-browser viewer"],
        link: "See the work",
        modello: "/modelli/ripamonti-eagle-1025.glb",
        alt: "Interactive 3D model of the Ripamonti Eagle 1025 drilling rig",
      },
    ],
    invito: "The next one could be yours.",
    invitoTesto: "Tell me what your website or software needs to do. The first conversation is to understand whether and how I can help; the actual analysis is the first phase of the work.",
    pulsante: "Let's talk about your project",
  },
}[lingua];
const poster = { carandina: undefined, ripamonti: posterRipamonti };
---

<section id="progetti" class="progetti" aria-labelledby="progetti-titolo">
  <div class="intestazione" data-linea="sotto" style="--colore-linea: var(--linea-scura)">
    <h2 id="progetti-titolo" data-rivela>{t.titolo}<span class="punto" aria-hidden="true">.</span></h2>
    <p class="intro" data-rivela style="--i: 1">{t.intro}</p>
  </div>

  <div class="griglia">
    {
      t.progetti.map((p, i) => (
        <article class="caso" data-rivela style={`--i: ${i}`}>
          <div class="anteprima">
            <Viewer3D src={p.modello} alt={p.alt} poster={poster[p.chiave]} />
          </div>
          <div class="corpo">
            <p class="etichetta tipo">{p.tipo}</p>
            <h3>{p.nome}</h3>
            <ol class="interventi">
              {p.punti.map((v, j) => (
                <li>
                  <span class="n" aria-hidden="true">0{j + 1}</span>
                  {v}
                </li>
              ))}
            </ol>
            <a class="link" href={percorsi[p.chiave][lingua]}>
              {p.link}<span class="visually-hidden"> — {p.nome}</span>
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                <path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5"></path>
              </svg>
            </a>
          </div>
        </article>
      ))
    }
  </div>

  <aside class="invito su-bianco" aria-labelledby="invito-titolo">
    <div class="invito-testo" data-rivela>
      <span class="quadratino" aria-hidden="true"></span>
      <h3 id="invito-titolo">{t.invito}</h3>
    </div>
    <div class="invito-azione" data-rivela style="--i: 1">
      <p>{t.invitoTesto}</p>
      <a class="pulsante pulsante-primario" href={percorsi.contatti[lingua]}>{t.pulsante}</a>
    </div>
  </aside>
</section>

<style>
  .progetti {
    background: var(--nero);
    color: var(--bianco);
    border-top: var(--bordo-scuro);
    border-bottom: var(--bordo);
  }

  .intestazione {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem var(--gap);
    padding: var(--pad-y) var(--pad-x) calc(var(--pad-y) * 0.6);
    border-bottom: var(--bordo-scuro);
  }

  h2 {
    font-size: var(--testo-h2);
    font-weight: var(--peso-extrabold);
  }

  .punto {
    color: var(--oro);
  }

  .intro {
    max-width: 36ch;
    font-size: var(--testo-lead);
    font-weight: var(--peso-light);
    color: var(--grigio-testo-scuro);
  }

  /* Due progetti, due card identiche: modello 3D sopra, testo sotto */
  .griglia {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .caso {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .caso + .caso {
    border-left: var(--bordo-scuro);
  }

  .anteprima {
    position: relative;
    height: clamp(300px, 32vw, 440px);
    background: var(--nero);
    border-bottom: var(--bordo-scuro);
  }

  .corpo {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: clamp(2rem, 1.5rem + 2vw, 3rem) var(--pad-x) var(--pad-y);
  }

  .tipo {
    color: var(--oro);
  }

  h3 {
    font-size: var(--testo-h3);
    font-weight: var(--peso-bold);
  }

  .caso h3 {
    margin-top: 1rem;
    font-size: clamp(2rem, 1.5rem + 2vw, 3.25rem);
    font-weight: var(--peso-extrabold);
  }

  .interventi {
    flex: 1;
    margin-top: 2rem;
    padding: 0;
    list-style: none;
    border-top: var(--bordo-scuro);
  }

  .interventi li {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: var(--bordo-scuro);
    font-weight: var(--peso-medium);
  }

  .n {
    color: var(--grigio-testo-scuro);
    font-size: var(--testo-small);
    font-variant-numeric: tabular-nums;
  }

  .link {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.6rem;
    min-height: 44px;
    margin-top: 2rem;
    font-size: var(--testo-small);
    font-weight: var(--peso-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 6px;
    transition: text-decoration-color var(--durata) var(--easing);
  }

  .link:hover {
    text-decoration-color: var(--oro);
  }

  /* Card bianca verso i contatti */
  .invito {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem calc(var(--pad-x) * 2);
    align-items: end;
    padding: var(--pad-y) var(--pad-x);
    background: var(--bianco);
    color: var(--nero);
    border-top: var(--bordo-scuro);
  }

  .quadratino {
    width: 12px;
    height: 12px;
    margin-bottom: 1.75rem;
    background: var(--oro);
  }

  .invito h3 {
    max-width: 14ch;
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.75rem);
    font-weight: var(--peso-extrabold);
  }

  .invito p {
    max-width: 36ch;
    margin-top: 1.25rem;
    color: var(--grigio-testo-chiaro);
  }

  .invito p {
    margin-top: 0;
  }

  .invito .pulsante {
    margin-top: 1.75rem;
  }

  @media (max-width: 900px) {
    .griglia,
    .invito {
      grid-template-columns: 1fr;
    }

    .caso + .caso {
      border-left: 0;
      border-top: var(--bordo-scuro);
    }
  }

  @media (max-width: 768px) {
    .anteprima {
      height: 300px;
    }

    .invito .pulsante {
      width: 100%;
    }
  }
</style>
